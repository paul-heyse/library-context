+        self.lookup_export(module_data)
+    }
+
+    /// The names `from <module> import *` binds.
+    pub fn get_wildcard(&self, handle: &Handle) -> Arc<SmallSet<Name>> {
         let module_data = self.get_module(handle);
         self.lookup_export(module_data)
+            .wildcard(&self.lookup(module_data))
     }
 
