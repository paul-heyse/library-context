+// Complete encoded response ceilings are independent of decoded-memory admission.
+// The allowance covers batch scalar metadata, nested tags and bounded stats. Error
+// details still go through actual encoded_len and fail as a transport status when
+// they cannot be represented under the caller's chosen complete-frame ceiling.
+const QUERY_ENVELOPE_ALLOWANCE: usize = 1024;
+
+fn query_byte_limit(requested: u32) -> Result<Option<usize>, Status> {
+	if requested == 0 { return Ok(None); }
+	let requested = requested as usize;
+	if requested <= QUERY_ENVELOPE_ALLOWANCE {
+		return Err(Status::invalid_argument(format!(
+			"max_batch_bytes must exceed the {QUERY_ENVELOPE_ALLOWANCE}-byte query envelope allowance"
+		)));
+	}
+	Ok(Some(requested.min(frame_payload_budget())))
+}
+
+fn checked_query_frame(frame: rpc::QueryResponse, limit: Option<usize>) -> Result<rpc::QueryResponse, Status> {
+	use surrealdb_types::prost::Message;
+	if let Some(limit) = limit {
+		let actual = frame.encoded_len();
+		if actual > limit {
+			return Err(Status::out_of_range(format!(
+				"Query response encodes to {actual} bytes, above requested max_batch_bytes {limit}"
+			)));
+		}
+	}
+	Ok(frame)
+}
+
 /// Hands back a unary response once it is known to encode within
 /// [`frame_payload_budget`], refusing it as a status naming the limit
 /// otherwise.
