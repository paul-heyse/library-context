+//! Request ownership across gRPC delivery loss and server shutdown.
+//! Accepted permits fence shutdown until execution, cleanup and terminal delivery
+//! ownership have been resolved. A transport drop cannot abort those futures.
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use tokio::task::JoinHandle;
+use tokio_util::task::TaskTracker;
+use tokio_util::task::task_tracker::TaskTrackerToken;
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+type Cancel = Arc<dyn Fn() + Send + Sync>;
+
+struct Admission {
+	accepting: bool,
+	requests: HashMap<Uuid, Cancel>,
+}
+
+pub(super) struct QueryDrains {
+	admission: Mutex<Admission>,
+	tracker: TaskTracker,
+	unresolved: AtomicUsize,
+}
+
+impl QueryDrains {
+	pub(super) fn new() -> Arc<Self> {
+		Arc::new(Self {
+			admission: Mutex::new(Admission { accepting: true, requests: HashMap::new() }),
+			tracker: TaskTracker::new(),
+			unresolved: AtomicUsize::new(0),
+		})
+	}
+
+	pub(super) fn accept(self: &Arc<Self>, id: Uuid, cancel: Cancel) -> Result<QueryPermit, ()> {
+		let mut admission = self.admission.lock().expect("query admission poisoned");
+		if !admission.accepting || admission.requests.contains_key(&id) {
+			return Err(());
+		}
+		// Acquire under the admission fence, before any execution can be accepted.
+		let token = self.tracker.token();
+		admission.requests.insert(id, cancel);
+		Ok(QueryPermit { owner: Arc::clone(self), id, _token: token,
+			finished: CancellationToken::new(), armed: false })
+	}
+
+	pub(super) fn close(&self) {
+		let mut admission = self.admission.lock().expect("query admission poisoned");
+		admission.accepting = false;
+		for cancel in admission.requests.values() { cancel(); }
+		// close permits later tasks, but accepted permits prevent a transient empty
+		// tracker while their sole execution/cleanup owner is being transferred.
+		self.tracker.close();
+	}
+
+	pub(super) fn record_unresolved(&self) {
+		self.unresolved.fetch_add(1, Ordering::Release);
+	}
+
+	pub(super) async fn wait(&self) -> Result<(), usize> {
+		self.tracker.wait().await;
+		match self.unresolved.load(Ordering::Acquire) {
+			0 => Ok(()), count => Err(count),
+		}
+	}
+}
+
+pub(super) struct QueryPermit {
+	owner: Arc<QueryDrains>,
+	id: Uuid,
+	_token: TaskTrackerToken,
+	finished: CancellationToken,
+	armed: bool,
+}
+
+impl QueryPermit {
+	pub(super) fn id(&self) -> Uuid { self.id }
+	pub(super) fn arm(&mut self) { self.armed = true; }
+	pub(super) fn complete(mut self) { self.armed = false; }
+
+	pub(super) fn watchdog<F>(&self, future: F)
+	where F: Future<Output = ()> + Send + 'static {
+		let finished = self.finished.clone();
+		drop(self.owner.tracker.spawn(async move {
+			tokio::select! { _ = finished.cancelled() => (), _ = future => () }
+		}));
+	}
+
+	/// The future owns the permit and must explicitly complete it or transfer it
+	/// to Delivery. Panic/runtime loss cannot silently become successful finality.
+	pub(super) fn handoff<F, B>(mut self, build: B) -> JoinHandle<F::Output>
+	where B: FnOnce(Self) -> F + Send + 'static,
+		F: Future + Send + 'static, F::Output: Send + 'static,
+	{
+		self.arm();
+		let tracker = self.owner.tracker.clone();
+		tracker.spawn(async move { build(self).await })
+	}
+
+	#[cfg(test)]
+	fn spawn<F>(self, future: F) -> JoinHandle<F::Output>
+	where F: Future + Send + 'static, F::Output: Send + 'static {
+		self.handoff(move |permit| async move {
+			let output = future.await;
+			permit.complete();
+			output
+		})
+	}
+}
+
+impl Drop for QueryPermit {
+	fn drop(&mut self) {
+		if self.armed { self.owner.record_unresolved(); }
+		self.finished.cancel();
+		self.owner.admission.lock().expect("query admission poisoned").requests.remove(&self.id);
+	}
+}
+
+/// Linear handoff between an asynchronous finalizer and synchronous stream EOF
+/// or Drop. Ready retains all cleanup authority, including already registered
+/// LIVE IDs. Only observing healthy EOF releases that authority to the session.
+pub(super) struct Delivery<T> {
+	phase: Mutex<DeliveryPhase<T>>,
+}
+
+enum DeliveryPhase<T> { Running, Ready(T), Abandoned, Released, Failed }
+
+impl<T> Delivery<T> {
+	pub(super) fn new() -> Arc<Self> {
+		Arc::new(Self { phase: Mutex::new(DeliveryPhase::Running) })
+	}
+	pub(super) fn abandoned(&self) -> bool {
+		matches!(*self.phase.lock().expect("query delivery poisoned"), DeliveryPhase::Abandoned)
+	}
+	pub(super) fn publish(&self, value: T) -> Result<(), T> {
+		let mut phase = self.phase.lock().expect("query delivery poisoned");
+		match &*phase {
+			DeliveryPhase::Abandoned => Err(value),
+			DeliveryPhase::Running => { *phase = DeliveryPhase::Ready(value); Ok(()) }
+			_ => panic!("query finality published twice"),
+		}
+	}
+	pub(super) fn abandon(&self) -> Option<T> {
+		let mut phase = self.phase.lock().expect("query delivery poisoned");
+		match std::mem::replace(&mut *phase, DeliveryPhase::Abandoned) {
+			DeliveryPhase::Ready(value) => Some(value),
+			DeliveryPhase::Released => { *phase = DeliveryPhase::Released; None }
+			_ => None,
+		}
+	}
+	pub(super) fn failed(&self) {
+		let mut phase = self.phase.lock().expect("query delivery poisoned");
+		if matches!(*phase, DeliveryPhase::Running) { *phase = DeliveryPhase::Failed; }
+	}
+	pub(super) fn healthy_eof(&self) -> Option<T> {
+		let mut phase = self.phase.lock().expect("query delivery poisoned");
+		match std::mem::replace(&mut *phase, DeliveryPhase::Released) {
+			DeliveryPhase::Ready(value) => Some(value),
+			DeliveryPhase::Abandoned => { *phase = DeliveryPhase::Abandoned; None }
+			DeliveryPhase::Released | DeliveryPhase::Failed => None,
+			DeliveryPhase::Running => panic!("query EOF precedes finality"),
+		}
+	}
+}
