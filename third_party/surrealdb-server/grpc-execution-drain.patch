+	#[tokio::test]
+	async fn accepted_permit_fences_shutdown_until_transferred_finalizer_settles() {
+		let owner = QueryDrains::new();
+		let cancelled = Arc::new(AtomicUsize::new(0));
+		let observed = Arc::clone(&cancelled);
+		let permit = owner.accept(Uuid::new_v4(), Arc::new(move || { observed.fetch_add(1, Ordering::Relaxed); })).unwrap();
+		owner.close();
+		assert_eq!(cancelled.load(Ordering::Relaxed), 1);
+		assert!(owner.accept(Uuid::new_v4(), Arc::new(|| {})).is_err());
+		assert!(owner.wait().now_or_never().is_none());
+		let (send, receive) = oneshot::channel();
+		drop(permit.spawn(async move { receive.await.unwrap(); }));
+		assert!(owner.wait().now_or_never().is_none());
+		send.send(()).unwrap();
+		assert_eq!(owner.wait().await, Ok(()));
+		assert!(owner.admission.lock().unwrap().requests.is_empty());
+	}
+
