+				assert!(delivery.abandon().is_none());
+			} else {
+				let ready = delivery.abandon().expect("Drop takes completed cleanup authority");
+				let (send, receive) = oneshot::channel();
+				drop(ready.handoff(move |permit| async move {
+					receive.await.unwrap();
+					permit.complete();
+				}));
+				assert!(owner.wait().now_or_never().is_none());
+				send.send(()).unwrap();
+			}
+			assert_eq!(owner.wait().await, Ok(()));
+		}
