+		for healthy in [false, true] {
+			let owner = QueryDrains::new();
+			let permit = owner.accept(Uuid::new_v4(), Arc::new(|| {})).unwrap();
+			let delivery = Delivery::new();
+			let finalizer_delivery = Arc::clone(&delivery);
+			permit.handoff(move |permit| async move {
+				assert!(finalizer_delivery.publish(permit).is_ok());
+			}).await.unwrap();
