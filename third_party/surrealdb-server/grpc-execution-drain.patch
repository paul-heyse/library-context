+	#[tokio::test]
+	async fn drop_during_normal_finalization_returns_cleanup_ownership_exactly_once() {
+		let owner = QueryDrains::new();
+		let permit = owner.accept(Uuid::new_v4(), Arc::new(|| {})).unwrap();
+		let delivery = Delivery::new();
+		let finalizer_delivery = Arc::clone(&delivery);
+		let (entered, barrier) = oneshot::channel();
+		let (release, resume) = oneshot::channel();
+		let cleaned = Arc::new(AtomicUsize::new(0));
+		let observed = Arc::clone(&cleaned);
+		let finalizer = permit.handoff(move |permit| async move {
+			// Deterministic barrier models an await during normal LIVE registration.
+			assert!(!finalizer_delivery.abandoned());
+			entered.send(()).unwrap();
+			resume.await.unwrap();
+			let returned = finalizer_delivery.publish(permit).err().expect("Drop won the handoff");
+			observed.fetch_add(1, Ordering::Relaxed);
+			returned.complete();
+		});
+		barrier.await.unwrap();
+		assert!(delivery.abandon().is_none(), "finalizer still owns cleanup");
+		owner.close();
+		assert!(owner.wait().now_or_never().is_none());
+		release.send(()).unwrap();
+		finalizer.await.unwrap();
+		assert_eq!(owner.wait().await, Ok(()));
+		assert_eq!(cleaned.load(Ordering::Relaxed), 1);
+		assert!(delivery.abandon().is_none());
+	}
+
