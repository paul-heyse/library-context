  "query": "SELECT DISTINCT ON (f.unit_id) f.unit_id,f.fragment_id,f.family,1.0-(v.vector OPERATOR(lctx_ext.<=>) $3::real[]::lctx_ext.vector(1024)) AS \"score!\" FROM lctx_serving.retrieval_vectors v JOIN lctx_serving.retrieval_fragments f ON f.generation_digest=v.generation_digest AND f.fragment_id=v.fragment_id WHERE v.generation_digest=$1 AND f.unit_id=ANY($2::bytea[]) ORDER BY f.unit_id,v.vector OPERATOR(lctx_ext.<=>) $3::real[]::lctx_ext.vector(1024),f.fragment_id LIMIT 200001\n",
