strict_env
PATH_rm '*/.venv/bin' '*/.venv-*/bin'
if [[ -n ${VIRTUAL_ENV-} ]]; then
    PATH_rm "$VIRTUAL_ENV/bin"
    unset VIRTUAL_ENV
fi
source_env_if_exists .envrc.local
_lctx_exports=$(env -u UV_NO_SYNC uv run --no-project --offline --no-python-downloads \
    --python "$(cat .python-version)" python scripts/build_environment.py --shell) || return $?
eval "$_lctx_exports"
unset _lctx_exports
_lctx_venv=${UV_PROJECT_ENVIRONMENT:-.venv}
PATH_add "$_lctx_venv/bin"
unset _lctx_venv
export UV_NO_SYNC=1
watch_file .python-version pyproject.toml uv.lock rust-toolchain.toml .cargo/config.toml
watch_file scripts/build_environment.py .dev/build-dir
