+// This shape is only considered after execute_request checks the original digest
+// and observe_request authenticates the exact original effect ID/generation/era/digest.
+// It never reaches intent/payload execution and does not make owner NONE a format6 owner.
+fn source5_installation_replay_candidate(owner:&EffectOwner,row:&Object)->bool{
+    matches!(owner,EffectOwner::Installation)
+        && row.get("owner_kind")==Some(&Value::String("installation".into()))
+        && row.get("owner").is_none_or(|value|*value==Value::None)
+        && row.get("attempt").is_none_or(|value|*value==Value::None)
+        && row.get("committed")==Some(&Value::Bool(true))
+        && row.get("resolved")==Some(&Value::Bool(true))
+}
+async fn validate_committed_replay_owner(client:&Surreal<Client>,request:NativeRequest,owner:&EffectOwner,row:&Object)->Result<(),ModelError>{
+    let ordinary=validate_replay_owner(request,owner,row);
+    if ordinary.is_ok(){return ordinary;}
+    if source5_installation_replay_candidate(owner,row)
+        && crate::upgrade::retained_source5_installation_outcome(client,row).await.map_err(|error|request.error(error))? {
+        return Ok(());
+    }
+    ordinary
+}
