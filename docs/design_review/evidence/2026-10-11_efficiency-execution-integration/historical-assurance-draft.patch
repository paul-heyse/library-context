+#[derive(Debug,Clone,Copy)]
+pub(super) enum Source5Configuration {ProducerSettings,CapturedAnalysisContext,Fixed(&'static [u8])}
+impl Source5Configuration {
+ fn encode(self,sink:&mut KeySink){match self {
+  Self::ProducerSettings=>sink.part(b"configuration-binding",b"producer-settings"),
+  Self::CapturedAnalysisContext=>sink.part(b"configuration-binding",b"captured-analysis-context"),
+  Self::Fixed(value)=>{sink.part(b"configuration-binding",b"fixed");ContentHash::of(value).encode(sink);}
+ }}
+}
