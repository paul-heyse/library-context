+pub(super) struct Source5ProviderDeclaration {
+ pub producer:&'static str,pub semantic_revision:u32,
+ /// Authentic facts inputs are all RelationUse::of: Handoff, prefix=None,
+ /// requirement=None, validators=[]. Preserve this declaration order as stored roles.
+ pub inputs:&'static [&'static str],pub outputs:&'static [&'static str],pub contributes:&'static [&'static str],
+ pub profiles:&'static [Profile],pub effect:&'static str,pub configuration:Source5Configuration,
+ pub suppliers:&'static [Source5Supplier],pub not_requested:&'static [FactFamily],
+ /// Observed acknowledged contract IDs cross-check five authentic catalog producers.
+ /// TyFlow is source recovered but absent from this retained catalog artifact.
+ pub observed_contract:Option<&'static str>,pub original_source:&'static str,pub source_sha256:&'static str,
+}
+impl Source5ProviderDeclaration {
+ pub fn identity(&self)->ContentHash{
+  let mut sink=KeySink::new("producer-semantic-contract/v1");
+  self.producer.to_owned().encode(&mut sink);sink.part(b"revision",&self.semantic_revision.to_le_bytes());
+  sink.part(b"effect",self.effect.as_bytes());self.configuration.encode(&mut sink);
+  let mut profiles=self.profiles.to_vec();profiles.sort();for profile in profiles{profile.name().to_owned().encode(&mut sink);}
+  let mut inputs=self.inputs.to_vec();inputs.sort();
+  for input in inputs {input.to_owned().encode(&mut sink);Option::<i16>::None.encode(&mut sink);sink.part(b"transport",b"handoff");}
+  for (tag,relations) in [(b"output".as_slice(),self.outputs),(b"contributes".as_slice(),self.contributes)]{
+   for name in relations.iter().copied().collect::<BTreeSet<_>>(){sink.part(tag,name.as_bytes());}
+  }
+  let mut suppliers=self.suppliers.iter().collect::<Vec<_>>();suppliers.sort_by_key(|role|role.role);
+  for role in suppliers {role.role.to_owned().encode(&mut sink);role.tool.to_owned().encode(&mut sink);role.analyzer_revision.to_owned().encode(&mut sink);sink.part(b"supplier-semantic-revision",&role.semantic_revision.to_le_bytes());role.configuration.encode(&mut sink);for family in role.families.iter().copied().collect::<BTreeSet<_>>(){family.encode(&mut sink);}}
+  for family in self.not_requested.iter().copied().collect::<BTreeSet<_>>(){sink.part(b"not-requested",&[family as u8]);}
+  sink.finish()
+ }
+ /// Evidence-only declaration checks. Not native selection or semantic row-validation proof.
+ pub fn check(&self,original:&Source5ProducerEvidence,providers:&[Provider])->Result<(),ModelError>{
+  let binding=original.binding.as_ref().ok_or(ModelError::Conflict("source5 provider binding absent"))?;
+  if original.producer!=self.producer || !self.profiles.contains(&original.profile)
+   || binding.semantic_revision!=self.semantic_revision || binding.contract!=self.identity()
+   || original.configuration!=Some(binding.producer_settings)
+   || matches!(self.configuration,Source5Configuration::Fixed(value) if binding.producer_settings!=ContentHash::of(value))
+   || original.inputs.iter().map(|input|input.relation()).ne(self.inputs.iter().copied())
+   || original.declared_outputs!=self.outputs.iter().chain(self.contributes).map(|name|(*name).to_owned()).collect()
+   || binding.suppliers.keys().map(String::as_str).collect::<BTreeSet<_>>()!=self.suppliers.iter().map(|role|role.role).collect()
+  {return Err(ModelError::Conflict("source5 original provider declaration"));}
+  for role in self.suppliers {
+   let id=binding.suppliers[role.role];let mut matched=providers.iter().filter(|provider|provider.id()==id);
+   let provider=matched.next().ok_or(ModelError::Conflict("source5 selected supplier absent"))?;
+   if matched.next().is_some() || provider.tool!=role.tool || provider.revision!=role.analyzer_revision{return Err(ModelError::Conflict("source5 selected supplier tool/revision"));}
+  }
+  Ok(())
+ }
+}
