+impl Source5PureDeclaration {
+ /// Authentic old stage-declaration digest (not Spec identity, implementation, or assurance).
+ /// Old stage digest canonically sorted inputs and outputs, and did not encode profiles.
+ pub fn source_declaration_identity(&self)->ContentHash {
+  let mut sink=KeySink::new("stage-declaration");Option::<ContentHash>::None.encode(&mut sink);
+  sink.part(b"stage",self.producer.as_bytes());sink.part(b"effect",b"pure");
+  sink.part(b"code",&self.code.identity().0);sink.part(b"configuration",&ContentHash::of(self.configuration_bytes).0);
