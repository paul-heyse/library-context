+/// Shape checking is not an assurance constructor. The fixed source registry and target
+/// validator driver still earn semantic translation and actual selected stream validation.
+fn preserved_target_shape(owner:&CompletedContribution,evidence:&PersistedSource5)->Result<(),ModelError>{
+    use super::completed::OutputProfile;
+    let original=&evidence.original;
+    if evidence.version!=1 || owner.spec.captured_binding.is_some()
+        || owner.spec.profile!=OutputProfile::Specific(original.profile)
+        || owner.spec.producer!=original.producer
+        || owner.spec.implementation!=original.implementation
+        || owner.spec.configuration!=original.configuration || owner.outcome!=original.outcome
+        || evidence.input_roles.len()!=original.inputs.len()
+        || evidence.input_roles.len()!=owner.spec.inputs.len()
+        || evidence.outputs.len()!=owner.outputs.len()
+        || original.declared_outputs!=original.outputs.keys().cloned().collect()
+        || evidence.outputs.windows(2).any(|pair|pair[0].relation>=pair[1].relation)
+    {return Err(ModelError::Conflict("preserved source5 target declaration shape"));}
+    for (role,mapping) in evidence.input_roles.iter().enumerate(){
+        mapping.original.view.validate()?;
+        if mapping.role!=role as u64 || mapping.original.snapshot!=original.inputs[role]
+            || mapping.target!=owner.spec.inputs[role]
+            || mapping.original.snapshot.model()!=original.model
+            || mapping.target.model()!=owner.spec.model
+            || mapping.original.snapshot.view()!=mapping.original.view.identity
+            || mapping.original.snapshot.relation()!=mapping.original.view.relation
+            || u64::try_from(mapping.original.snapshot.rows()).ok()!=Some(mapping.original.view.rows)
+        {return Err(ModelError::Conflict("preserved source5 exact ordered input translation"));}
+    }
+    for output in &evidence.outputs{
+        if output.original.as_ref()!=original.outputs.get(&output.relation)
+            || owner.outputs.get(&output.relation)!=Some(&output.target)
+            || (output.original.is_none() && output.target.rows!=0)
+        {return Err(ModelError::Conflict("preserved source5 exact output translation"));}
+    }
+    if original.outputs.keys().any(|relation|!evidence.outputs.iter().any(|output|&output.relation==relation)){
+        return Err(ModelError::Conflict("preserved source5 dropped original output"));
+    }
+    Ok(())
+}
