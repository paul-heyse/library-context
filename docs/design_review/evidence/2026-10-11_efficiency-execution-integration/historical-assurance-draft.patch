+//! Original identity algorithms for the one supported adjacent source format.
+//! This module is historical typed evidence validation, never an old runtime reader.
+use super::{Source5CapturedBinding,Source5ProducerEvidence};
+use crate::domain::{ContentHash,Key,KeySink,ModelError};
+use std::collections::BTreeSet;
+
+pub(crate) const SOURCE_MODEL:&str="b6161054e824aac56f85bd596117e9f740b8416f35ebc3fe072ef81b34471da6";
+pub(crate) const SOURCE_SCHEMA:&str="eec4dc767fe4477fbfc3f5a584b54a6c8855345af02c3390ad5f77ac326e0383";
+
+/// Validates the exact old binding shape, including its original sorted source inventory.
+/// There is deliberately no acquisition capture completeness claim in this algorithm.
+pub(crate) fn original_binding_identity(binding:&Source5CapturedBinding)->Result<ContentHash,ModelError>{
+    if binding.semantic_revision==0 || binding.suppliers.keys().any(String::is_empty)
+        || binding.suppliers.values().copied().collect::<BTreeSet<_>>().len()!=binding.suppliers.len()
+        || !binding.sources.windows(2).all(|pair|pair[0].input<pair[1].input) {
+        return Err(ModelError::Conflict("source5 captured producer binding shape"));
+    }
+    let mut sink=KeySink::new("captured-producer-binding/v1");
+    binding.contract.encode(&mut sink);sink.part(b"revision",&binding.semantic_revision.to_le_bytes());
+    binding.producer_settings.encode(&mut sink);
+    for (role,provider) in &binding.suppliers {role.encode(&mut sink);provider.encode(&mut sink);}
+    for source in &binding.sources {source.input.encode(&mut sink);source.context.encode(&mut sink);source.configuration.encode(&mut sink);}
+    Ok(sink.finish())
+}
+
+/// Authentic source5 Spec/v2 used a SET for the identity, even though its stored role Vec
+/// retains order and repetition. Target translation must preserve that actual Vec separately.
+pub(crate) fn original_spec_identity(evidence:&Source5ProducerEvidence)->Result<ContentHash,ModelError>{
+    if evidence.producer.is_empty(){return Err(ModelError::Conflict("source5 empty producer"));}
+    if evidence.binding.as_ref().is_some_and(|binding|evidence.configuration!=Some(binding.producer_settings)){
+        return Err(ModelError::Conflict("source5 captured producer settings"));
+    }
+    let mut input_ids=evidence.inputs.iter().map(|input|input.identity()).collect::<Vec<_>>();
+    input_ids.sort();input_ids.dedup();
+    let mut sink=KeySink::new("compiler-contribution-spec/v2");
+    evidence.binding.as_ref().map(original_binding_identity).transpose()?.encode(&mut sink);
+    evidence.producer.encode(&mut sink);evidence.profile.name().to_string().encode(&mut sink);
+    evidence.model.encode(&mut sink);evidence.implementation.encode(&mut sink);
+    evidence.configuration.encode(&mut sink);input_ids.encode(&mut sink);
+    // Keep original declarations distinct from completed observations during cold readback.
+    for output in &evidence.declared_outputs{output.encode(&mut sink);}
+    Ok(sink.finish())
+}
+pub(crate) fn original_contribution_identity(evidence:&Source5ProducerEvidence)->Result<ContentHash,ModelError>{
+    if !(0..=4).contains(&evidence.outcome) || evidence.outcome==3
+        || evidence.declared_outputs!=evidence.outputs.keys().cloned().collect::<BTreeSet<_>>() {
+        return Err(ModelError::Conflict("source5 incomplete contribution outcome"));
+    }
+    let mut sink=KeySink::new("compiler-completed-contribution/v1");
+    original_spec_identity(evidence)?.encode(&mut sink);evidence.outcome.encode(&mut sink);
+    for (name,output) in &evidence.outputs {name.encode(&mut sink);sink.part(b"rows",&output.rows.to_le_bytes());output.content.encode(&mut sink);}
+    Ok(sink.finish())
+}
+/// Exact identity correspondence is one premise. It deliberately cannot mint a semantic
+/// declaration: supported source contracts, selected old rows and typed translations remain
+/// separate mandatory checks at the fixed admission driver.
+pub(crate) fn verify_original_identities(evidence:&Source5ProducerEvidence)->Result<(),ModelError>{
+    if evidence.model.hex()!=SOURCE_MODEL || evidence.inputs.iter().any(|input|input.model()!=evidence.model)
+        || original_spec_identity(evidence)?!=evidence.spec_identity
+        || original_contribution_identity(evidence)?!=evidence.contribution_identity {
+        return Err(ModelError::Conflict("source5 original model/spec/completed correspondence"));
+    }
+    Ok(())
+}
