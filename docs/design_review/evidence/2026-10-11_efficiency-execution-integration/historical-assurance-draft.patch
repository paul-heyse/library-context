+/// Authentic source5 publication binding identity. Version one omitted source
+/// attribution; keep this historical algorithm only to authenticate original bytes.
+/// Destination conversion always recomputes the complete version-two inventory.
+pub(crate) fn original_publication_binding_identity(bindings:&[crate::domain::completed::CompletedBinding])->Result<ContentHash,ModelError>{
+    let mut ordered=bindings.iter().collect::<Vec<_>>();ordered.sort_by_key(|binding|binding.key());
+    if ordered.windows(2).any(|pair|pair[0].key()==pair[1].key()){
+        return Err(ModelError::Conflict("source5 duplicate publication binding"));
+    }
+    let mut sink=KeySink::new("native-publication-view/v1");
+    for binding in ordered{
+        binding.validate()?;binding.key().encode(&mut sink);
+        binding.view.identity.encode(&mut sink);binding.configuration.encode(&mut sink);
+    }
+    Ok(sink.finish())
+}
