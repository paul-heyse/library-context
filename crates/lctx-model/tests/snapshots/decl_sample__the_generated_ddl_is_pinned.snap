---
source: crates/lctx-model/tests/decl_sample.rs
expression: text
---
CREATE TABLE "lctx"."codebook_id_kind" ("code" smallint PRIMARY KEY, "text" text NOT NULL UNIQUE);

INSERT INTO "lctx"."codebook_id_kind" ("code", "text") VALUES (0, 'occurrence'), (1, 'entity'), (2, 'symbol_key'), (3, 'place'), (4, 'atom'), (5, 'condition'), (6, 'condition_node'), (7, 'call_target'), (8, 'call_binding'), (9, 'transfer'), (10, 'obligation'), (11, 'derivation'), (12, 'finding'), (13, 'invocation'), (14, 'ddl'), (15, 'projection');

GRANT SELECT ON "lctx"."codebook_id_kind" TO "lctx_serving";

CREATE TABLE "lctx"."entities" (
    "generation_id" bytea NOT NULL,
    "entity_id" bytea NOT NULL,
    "distribution" text NOT NULL,
    "qualified_path" text NOT NULL,
    "descriptor" text NOT NULL,
    "run_id" bytea NOT NULL,
    CONSTRAINT "width_0" CHECK (octet_length("generation_id") = 16),
    CONSTRAINT "width_1" CHECK (octet_length("entity_id") = 16),
    CONSTRAINT "width_5" CHECK (octet_length("run_id") = 16),
    CONSTRAINT "entities_pk" PRIMARY KEY ("generation_id", "entity_id")
) PARTITION BY LIST ("generation_id");

CREATE INDEX "entities_i0" ON "lctx"."entities" ("qualified_path");

GRANT SELECT ON "lctx"."entities" TO "lctx_serving";

CREATE TABLE "lctx"."occurrences" (
    "generation_id" bytea NOT NULL,
    "occurrence_id" bytea NOT NULL,
    "module_id" bytea NOT NULL,
    "start_byte" bigint NOT NULL,
    "end_byte" bigint NOT NULL,
    "syntax_kind" text NOT NULL,
    "run_id" bytea NOT NULL,
    CONSTRAINT "width_0" CHECK (octet_length("generation_id") = 16),
    CONSTRAINT "width_1" CHECK (octet_length("occurrence_id") = 16),
    CONSTRAINT "width_2" CHECK (octet_length("module_id") = 16),
    CONSTRAINT "width_6" CHECK (octet_length("run_id") = 16),
    CONSTRAINT "span_ordered" CHECK (start_byte <= end_byte),
    CONSTRAINT "occurrences_pk" PRIMARY KEY ("generation_id", "occurrence_id"),
    CONSTRAINT "occurrences_fk0" FOREIGN KEY ("generation_id", "module_id") REFERENCES "lctx"."entities" ("generation_id", "entity_id")
) PARTITION BY LIST ("generation_id");

CREATE TABLE "lctx"."notes" (
    "generation_id" bytea NOT NULL,
    "note_id" bytea NOT NULL,
    "subject_id" bytea NOT NULL,
    "ordinal" bigint NOT NULL,
    "kind" smallint NOT NULL,
    "label" text,
    "tags" text[] NOT NULL,
    "scores" double precision[] NOT NULL,
    "weight" double precision NOT NULL,
    CONSTRAINT "width_0" CHECK (octet_length("generation_id") = 16),
    CONSTRAINT "width_1" CHECK (octet_length("note_id") = 16),
    CONSTRAINT "width_2" CHECK (octet_length("subject_id") = 16),
    CONSTRAINT "notes_pk" PRIMARY KEY ("generation_id", "note_id"),
    CONSTRAINT "notes_u0" UNIQUE ("generation_id", "subject_id", "ordinal"),
    CONSTRAINT "notes_fk0" FOREIGN KEY ("generation_id", "subject_id") REFERENCES "lctx"."occurrences" ("generation_id", "occurrence_id"),
    CONSTRAINT "notes_cb4" FOREIGN KEY ("kind") REFERENCES "lctx"."codebook_id_kind" ("code")
) PARTITION BY LIST ("generation_id");

-- staging templates for entities
CREATE TABLE {schema}."entities" (
    "generation_id" bytea DEFAULT '\x{generation}'::bytea NOT NULL,
    "entity_id" bytea NOT NULL,
    "distribution" text NOT NULL,
    "qualified_path" text NOT NULL,
    "descriptor" text NOT NULL,
    "run_id" bytea NOT NULL,
    CONSTRAINT "width_0" CHECK (octet_length("generation_id") = 16),
    CONSTRAINT "width_1" CHECK (octet_length("entity_id") = 16),
    CONSTRAINT "width_5" CHECK (octet_length("run_id") = 16),
    CONSTRAINT "partition" CHECK ("generation_id" = '\x{generation}'::bytea)
);
CREATE UNIQUE INDEX "entities_pk" ON {schema}."entities" ("generation_id", "entity_id");
CREATE INDEX "entities_i0" ON {schema}."entities" ("qualified_path");
ALTER TABLE "lctx"."entities" ATTACH PARTITION {schema}."entities" FOR VALUES IN ('\x{generation}'::bytea);
ALTER TABLE "lctx"."entities" DETACH PARTITION {schema}."entities" CONCURRENTLY;

-- staging templates for occurrences
CREATE TABLE {schema}."occurrences" (
    "generation_id" bytea DEFAULT '\x{generation}'::bytea NOT NULL,
    "occurrence_id" bytea NOT NULL,
    "module_id" bytea NOT NULL,
    "start_byte" bigint NOT NULL,
    "end_byte" bigint NOT NULL,
