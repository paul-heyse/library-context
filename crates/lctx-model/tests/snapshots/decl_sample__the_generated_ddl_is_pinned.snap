    CONSTRAINT "span_ordered" CHECK (start_byte <= end_byte),
    CONSTRAINT "partition" CHECK ("generation_id" = '\x{generation}'::bytea)
);
CREATE UNIQUE INDEX "occurrences_pk" ON {schema}."occurrences" ("generation_id", "occurrence_id");
ALTER TABLE "lctx"."occurrences" ATTACH PARTITION {schema}."occurrences" FOR VALUES IN ('\x{generation}'::bytea);
ALTER TABLE "lctx"."occurrences" DETACH PARTITION {schema}."occurrences" CONCURRENTLY;

-- staging templates for notes
CREATE TABLE {schema}."notes" (
    "generation_id" bytea DEFAULT '\x{generation}'::bytea NOT NULL,
    "note_id" bytea NOT NULL,
    "subject_id" bytea NOT NULL,
    "ordinal" bigint NOT NULL,
    "kind" smallint NOT NULL,
    "label" text,
    "tags" text[] NOT NULL,
    "scores" double precision[] NOT NULL,
    "weight" double precision NOT NULL,
    CONSTRAINT "width_0" CHECK (octet_length("generation_id") = 16),
    CONSTRAINT "width_1" CHECK (octet_length("note_id") = 16),
    CONSTRAINT "width_2" CHECK (octet_length("subject_id") = 16),
    CONSTRAINT "partition" CHECK ("generation_id" = '\x{generation}'::bytea)
);
CREATE UNIQUE INDEX "notes_pk" ON {schema}."notes" ("generation_id", "note_id");
CREATE UNIQUE INDEX "notes_u0" ON {schema}."notes" ("generation_id", "subject_id", "ordinal");
ALTER TABLE "lctx"."notes" ATTACH PARTITION {schema}."notes" FOR VALUES IN ('\x{generation}'::bytea);
ALTER TABLE "lctx"."notes" DETACH PARTITION {schema}."notes" CONCURRENTLY
