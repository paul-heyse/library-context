---
source: crates/lctx-surrealdb/src/schema.rs
expression: statements
---
DEFINE TABLE entity TYPE NORMAL SCHEMAFULL;
DEFINE FIELD semantic_type ON entity TYPE string;
DEFINE FIELD semantic_key ON entity TYPE string;
DEFINE FIELD anchor ON entity TYPE record<entity_anchor | assertion_anchor>;
DEFINE FIELD kind ON entity TYPE int;
DEFINE FIELD subtype ON entity TYPE int | null;
DEFINE FIELD content ON entity TYPE string;
DEFINE INDEX anchor_payload ON entity FIELDS anchor,content;
DEFINE FIELD canonical ON entity TYPE bytes;
DEFINE FIELD body ON entity TYPE object FLEXIBLE;
DEFINE INDEX semantic_key ON entity FIELDS semantic_type,semantic_key;
DEFINE TABLE entity_anchor SCHEMAFULL;
DEFINE FIELD family ON entity_anchor TYPE string;
DEFINE FIELD nominal ON entity_anchor TYPE string;
DEFINE INDEX anchor_nominal ON entity_anchor FIELDS nominal UNIQUE;
DEFINE TABLE assertion TYPE NORMAL SCHEMAFULL;
DEFINE FIELD semantic_type ON assertion TYPE string;
DEFINE FIELD semantic_key ON assertion TYPE string;
DEFINE FIELD anchor ON assertion TYPE record<entity_anchor | assertion_anchor>;
DEFINE FIELD kind ON assertion TYPE int;
DEFINE FIELD subtype ON assertion TYPE int | null;
DEFINE FIELD content ON assertion TYPE string;
DEFINE INDEX anchor_payload ON assertion FIELDS anchor,content;
DEFINE FIELD canonical ON assertion TYPE bytes;
DEFINE FIELD body ON assertion TYPE object FLEXIBLE;
DEFINE INDEX semantic_key ON assertion FIELDS semantic_type,semantic_key;
DEFINE TABLE assertion_anchor SCHEMAFULL;
DEFINE FIELD family ON assertion_anchor TYPE string;
DEFINE FIELD nominal ON assertion_anchor TYPE string;
DEFINE INDEX anchor_nominal ON assertion_anchor FIELDS nominal UNIQUE;
DEFINE FIELD scope_context ON entity TYPE option<string>;
DEFINE FIELD scope_keys ON entity TYPE array<string>;
DEFINE INDEX by_scope ON entity FIELDS scope_keys.*,semantic_key;
DEFINE FIELD scope_context ON assertion TYPE option<string>;
DEFINE FIELD scope_keys ON assertion TYPE array<string>;
DEFINE INDEX by_scope ON assertion FIELDS scope_keys.*,semantic_key;
DEFINE TABLE participant TYPE RELATION IN assertion OUT entity_anchor | assertion_anchor | external ENFORCED SCHEMAFULL;
DEFINE FIELD field ON participant TYPE string;
DEFINE FIELD role ON participant TYPE int;
DEFINE FIELD position ON participant TYPE int | null;
DEFINE INDEX incoming ON participant FIELDS out,field,in;
DEFINE INDEX outgoing ON participant FIELDS in,field,out,position;
DEFINE TABLE reference TYPE RELATION IN entity OUT entity_anchor | assertion_anchor | external ENFORCED SCHEMAFULL;
DEFINE FIELD field ON reference TYPE string;
DEFINE FIELD role ON reference TYPE int;
DEFINE FIELD position ON reference TYPE int | null;
DEFINE INDEX incoming ON reference FIELDS out,field,in;
DEFINE INDEX outgoing ON reference FIELDS in,field,out,position;
DEFINE TABLE external TYPE NORMAL SCHEMAFULL;
DEFINE FIELD canonical ON external TYPE bytes;
DEFINE TABLE original TYPE NORMAL SCHEMAFULL;
DEFINE FIELD content ON original TYPE string;
DEFINE FIELD byte_len ON original TYPE int;
DEFINE TABLE original_chunk TYPE NORMAL SCHEMAFULL;
DEFINE FIELD source ON original_chunk TYPE record<original>;
DEFINE FIELD start ON original_chunk TYPE int;
DEFINE FIELD bytes ON original_chunk TYPE bytes;
DEFINE FIELD content ON original_chunk TYPE string;
DEFINE INDEX position ON original_chunk FIELDS source,start UNIQUE;
DEFINE TABLE publication TYPE NORMAL SCHEMAFULL;
DEFINE FIELD handle ON publication TYPE string;
DEFINE FIELD manifest ON publication TYPE bytes;
DEFINE FIELD views ON publication TYPE bytes;
DEFINE FIELD definition_epoch ON publication TYPE string;
DEFINE TABLE compiler_record SCHEMAFULL;
DEFINE FIELD semantic_type ON compiler_record TYPE string;
DEFINE FIELD semantic_key ON compiler_record TYPE string;
DEFINE FIELD content ON compiler_record TYPE string;
DEFINE FIELD canonical ON compiler_record TYPE bytes;
DEFINE FIELD body ON compiler_record TYPE object FLEXIBLE;
DEFINE INDEX compiler_record_key ON compiler_record FIELDS semantic_type,semantic_key;
DEFINE FIELD scope_keys ON compiler_record TYPE array<string>;
DEFINE INDEX by_scope ON compiler_record FIELDS scope_keys.*,semantic_key;
