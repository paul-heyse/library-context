---
source: crates/cpg-core/tests/analysis.rs
expression: "text(&ctx,\n\"SELECT f.finding_kind, CAST(f.score AS BIGINT) AS score, \\\n                    (SELECT string_agg(m.label, ', ' ORDER BY m.ordinal) FROM finding_members m \\\n                     WHERE m.finding_id = f.finding_id AND m.role IN (11, 13)) AS objects_or_premise, \\\n                    (SELECT string_agg(m.label, ', ' ORDER BY m.ordinal) FROM finding_members m \\\n                     WHERE m.finding_id = f.finding_id AND m.role IN (12, 14)) AS intent_or_conclusion \\\n             FROM findings f WHERE f.finding_kind IN (13, 14) \\\n             ORDER BY f.finding_kind, objects_or_premise, intent_or_conclusion\",).await"
