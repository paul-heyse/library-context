---
source: crates/cpg-core/tests/analysis.rs
expression: "text(&ctx,\n\"SELECT s.label AS subject, f.score, f.evidence_status, f.witnesses_omitted, \\\n                    m.ordinal, m.role, m.label \\\n             FROM findings f JOIN finding_members m ON m.finding_id = f.finding_id \\\n             JOIN finding_members s ON s.finding_id = f.finding_id AND s.role = 9 \\\n               AND s.node_id = f.subject_node_id \\\n             WHERE f.finding_kind = 11 ORDER BY subject, m.ordinal\",).await"
