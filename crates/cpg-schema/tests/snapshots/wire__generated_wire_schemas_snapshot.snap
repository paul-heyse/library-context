{
  "find_operations.input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "FindOperationsRequest",
    "type": "object",
    "properties": {
      "library": {
        "$ref": "#/$defs/Text1To500"
      },
      "where": {
        "$ref": "#/$defs/Where"
      },
      "limit": {
        "$ref": "#/$defs/Limit50Default20",
        "default": 20
      },
      "cursor": {
        "anyOf": [
          {
            "$ref": "#/$defs/Text0To2048"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "additionalProperties": false,
    "required": [
      "library",
      "where"
    ],
    "$defs": {
      "Text1To500": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "Where": {
        "type": "object",
        "properties": {
          "facets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/FacetTerm"
            },
            "maxItems": 10,
            "default": []
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/OperationKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "path_prefix": {
            "anyOf": [
              {
                "$ref": "#/$defs/Text0To500"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "FacetTerm": {
        "type": "object",
        "properties": {
          "facet": {
            "$ref": "#/$defs/FacetName"
          },
          "value": {
            "$ref": "#/$defs/Text1To500"
          }
        },
        "additionalProperties": false,
        "required": [
          "facet",
          "value"
        ]
      },
      "FacetName": {
        "type": "string",
        "enum": [
          "parameter",
          "parameter_type",
          "returns",
          "raises",
          "decorator",
          "async",
          "delegates_to",
          "forwards_to",
          "hands_off_to",
          "takes_from",
          "module",
          "kind",
          "reads_setting"
        ]
      },
      "OperationKind": {
        "type": "string",
        "enum": [
          "function",
          "method",
          "class"
        ]
      },
      "Text0To500": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500
      },
      "Limit50Default20": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "Text0To2048": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      }
    }
  },
  "find_operations.output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "FindOperationsResponse",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "results"
          }
        },
        "$ref": "#/$defs/OperationSet",
        "required": [
          "result_kind"
        ]
      }
    ],
    "$defs": {
      "SnapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "GenerationDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F]{64}$"
      },
      "OperationRef": {
        "type": "object",
        "properties": {
          "operation_id": {
            "$ref": "#/$defs/OperationId"
          },
          "access_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "docstring_summary": {
            "$ref": "#/$defs/Nullablestring"
          },
          "behavior_status": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "access_path",
          "kind",
          "docstring_summary",
          "behavior_status"
        ]
      },
      "OperationId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "Nullablestring": {
        "type": [
          "string",
          "null"
        ]
      },
      "OperationSet": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OperationRef"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "complete": {
            "type": "boolean"
          },
          "unknown": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OperationRef"
            }
          },
          "unknown_total": {
            "type": "integer",
            "format": "int64"
          },
          "unknown_truncated": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "$ref": "#/$defs/Nullablestring"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "generation",
          "matches",
          "total",
          "complete",
          "unknown",
          "unknown_total",
          "unknown_truncated",
          "truncated",
          "next_cursor",
          "note"
        ]
      }
    },
    "type": "object"
  },
