      "limit": {
        "$ref": "#/$defs/Limit50Default20",
        "default": 20
      },
      "cursor": {
        "anyOf": [
          {
            "$ref": "#/$defs/Text0To2048"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "additionalProperties": false,
    "required": [
      "snapshot_id",
      "operation",
      "formal",
      "exact_input"
    ],
    "$defs": {
      "SnapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "Text1To500": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "ExactPrimitive": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "none"
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "bool"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "int"
              },
              "value": {
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "str"
              },
              "value": {
                "$ref": "#/$defs/Text0To500"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Text0To500": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500
      },
      "Limit50Default20": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "Text0To2048": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      }
    }
  },
  "inspect_value_paths.output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "InspectValuePathsResponse",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "paths"
          }
        },
        "$ref": "#/$defs/ValuePathPage",
        "required": [
          "result_kind"
        ]
      },
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "unavailable"
          }
        },
        "$ref": "#/$defs/CapabilityUnavailable",
        "required": [
          "result_kind"
        ]
      }
    ],
    "$defs": {
      "SnapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "GenerationDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F]{64}$"
      },
      "ExactPrimitive": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "none"
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "bool"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "int"
              },
              "value": {
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "str"
              },
              "value": {
                "$ref": "#/$defs/Text0To500"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Text0To500": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500
      },
      "ValuePath": {
        "type": "object",
        "properties": {
          "summary_id": {
            "type": "string"
          },
          "source_flow_fact_id": {
            "type": "string"
          },
          "source_origin_id": {
            "type": "string"
          },
          "source_verdict": {
            "type": "string"
          },
          "condition_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ProofStep"
            }
          },
          "exact_input_result": {
            "$ref": "#/$defs/ValuePathExactInputResult"
          },
          "value_links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ValueLinkEvidence"
            }
          },
          "boundary_reason": {
            "$ref": "#/$defs/Nullablestring"
          },
          "theory_work": {
            "$ref": "#/$defs/TheoryWork"
          }
        },
        "required": [
          "summary_id",
          "source_flow_fact_id",
          "source_origin_id",
          "source_verdict",
          "condition_id",
          "steps",
          "exact_input_result",
          "value_links",
          "boundary_reason",
          "theory_work"
        ]
      },
      "ProofStep": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "evidence_id": {
            "$ref": "#/$defs/EvidenceId"
          },
          "condition_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "evidence_id",
          "condition_id"
        ]
      },
      "EvidenceId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "ValuePathExactInputResult": {
        "type": "string",
        "enum": [
          "refuted_under_model",
          "compatible_under_model",
          "unknown"
        ]
      },
      "ValueLinkEvidence": {
        "type": "object",
        "properties": {
          "link_id": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/Nullablestring"
          },
          "start_byte": {
            "type": "integer",
            "format": "int64"
          },
          "end_byte": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "link_id",
          "path",
          "start_byte",
          "end_byte"
        ]
      },
      "Nullablestring": {
        "type": [
          "string",
          "null"
        ]
      },
      "TheoryWork": {
        "type": "object",
        "properties": {
          "links_examined": {
            "type": "integer",
            "format": "int64"
          },
          "assignments_applied": {
            "type": "integer",
            "format": "int64"
          },
          "bdd_preflight_pairs": {
            "type": "integer",
            "format": "int64"
          },
          "peak_bdd_nodes": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "links_examined",
          "assignments_applied",
          "bdd_preflight_pairs",
          "peak_bdd_nodes"
        ]
      },
      "OpenBoundary": {
        "type": "object",
        "properties": {
          "source_flow_fact_id": {
            "type": "string"
          },
          "source_origin_id": {
            "type": "string"
          },
          "condition_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "source_flow_fact_id",
          "source_origin_id",
          "condition_id",
          "reason"
        ]
      },
      "ValuePathPage": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          },
          "operation": {
            "type": "string"
          },
          "formal": {
            "type": "string"
          },
          "exact_input": {
            "$ref": "#/$defs/ExactPrimitive"
          },
          "standard_builtins": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ValuePath"
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpenBoundary"
            }
          },
          "total_rows": {
            "type": "integer",
            "format": "int64"
          },
          "examined_rows": {
            "type": "integer",
            "format": "int64"
          },
          "theory_work": {
            "$ref": "#/$defs/TheoryWork"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "$ref": "#/$defs/Nullablestring"
          },
          "note": {
            "type": "string",
            "default": "A refutation applies only to its cited summary path under the exact input model. Compatibility means only a satisfiable model after checked value links, not a concrete execution. Unknown and absent paths do not establish absence."
          }
        },
        "required": [
          "snapshot_id",
          "generation",
          "operation",
          "formal",
          "exact_input",
          "standard_builtins",
          "paths",
          "boundaries",
          "total_rows",
          "examined_rows",
          "theory_work",
          "truncated",
          "next_cursor",
          "note"
        ]
      },
      "CapabilityUnavailableStatus": {
        "type": "string",
        "enum": [
          "unavailable"
        ]
      },
      "CapabilityUnavailableReason": {
        "type": "string",
        "enum": [
          "not_requested"
        ]
      },
      "CapabilityUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/$defs/CapabilityUnavailableStatus",
            "default": "unavailable"
          },
          "reason": {
            "$ref": "#/$defs/CapabilityUnavailableReason",
            "default": "not_requested"
          },
          "capability": {
            "type": "string"
          },
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          }
        },
        "required": [
          "status",
          "reason",
          "capability",
          "snapshot_id",
          "generation"
        ]
      }
    },
    "type": "object"
  },
  "search_capabilities.input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SearchCapabilitiesRequest",
    "type": "object",
    "properties": {
      "library": {
        "$ref": "#/$defs/Text1To500"
      },
      "query": {
        "$ref": "#/$defs/Text1To4000"
      },
      "limit": {
        "$ref": "#/$defs/Limit10Default5",
        "default": 5
      }
    },
    "additionalProperties": false,
    "required": [
      "library",
      "query"
    ],
    "$defs": {
      "Text1To500": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "Text1To4000": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "Limit10Default5": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    }
  },
  "search_capabilities.output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SearchCapabilitiesResponse",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "results"
          }
        },
        "$ref": "#/$defs/SearchResult",
        "required": [
          "result_kind"
        ]
      },
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "unavailable"
          }
        },
        "$ref": "#/$defs/CapabilityUnavailable",
        "required": [
          "result_kind"
        ]
      }
    ],
    "$defs": {
      "RetrievalMetadata": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "requested_route": {
            "$ref": "#/$defs/RetrievalMetadataRequestedRoute"
          },
          "actual_route": {
            "$ref": "#/$defs/RetrievalMetadataActualRoute"
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "candidate_depth": {
            "type": "integer",
            "format": "int64",
            "default": 0
          },
          "approximate": {
            "type": "boolean",
            "default": false
          },
          "routing_reason": {
            "type": "string",
            "default": "explicit_profile"
          },
          "admission": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "profile",
          "requested_route",
          "actual_route",
          "fallback",
          "candidate_depth",
          "approximate",
          "routing_reason",
          "admission"
        ]
      },
      "RetrievalMetadataRequestedRoute": {
        "type": "string",
        "enum": [
          "exact",
          "hnsw",
          "mixed"
        ]
      },
      "RetrievalMetadataActualRoute": {
        "type": "string",
        "enum": [
          "exact",
          "hnsw",
          "lexical-only"
        ]
      },
      "SnapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "GenerationDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F]{64}$"
      },
      "SearchResultMode": {
        "type": "string",
        "enum": [
          "hybrid",
          "lexical-only"
        ]
      },
      "Nullablestring": {
        "type": [
          "string",
          "null"
        ]
      },
      "CoverageSummary": {
        "description": "Context rendered by MCP, derived once from the canonical published snapshot.",
        "type": "object",
        "properties": {
          "coverage": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              }
            }
          },
          "boundaries": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "invocations": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "briefs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          },
          "unresolved_slots": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "absent_slots": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "slot_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "coverage",
          "boundaries",
          "invocations",
          "briefs",
          "unresolved_slots",
          "absent_slots",
          "slot_sections"
        ]
      },
      "Hit": {
        "type": "object",
        "properties": {
          "capability_id": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/$defs/Nullablestring"
          },
          "outcome_status": {
            "type": "string"
          },
          "relevance": {
            "type": "number",
            "format": "double"
          },
          "rank_source": {
            "$ref": "#/$defs/RankSource"
          },
          "promoted": {
            "type": "boolean"
          }
        },
        "required": [
          "capability_id",
          "title",
          "outcome",
          "outcome_status",
          "relevance",
          "rank_source",
          "promoted"
        ]
      },
      "CapabilityId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "RankSource": {
        "type": "string",
        "enum": [
          "hybrid",
          "lexical",
          "vector",
          "exact_symbol"
        ]
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "retrieval": {
            "$ref": "#/$defs/RetrievalMetadata"
          },
          "library": {
            "type": "string"
          },
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          },
          "mode": {
            "$ref": "#/$defs/SearchResultMode"
          },
          "degraded_reason": {
            "$ref": "#/$defs/Nullablestring"
          },
          "coverage": {
            "$ref": "#/$defs/CoverageSummary"
          },
          "note": {
            "type": "string"
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Hit"
            }
          }
        },
        "required": [
          "retrieval",
          "library",
          "snapshot_id",
          "generation",
          "mode",
          "degraded_reason",
          "coverage",
          "note",
          "hits"
        ]
      },
      "CapabilityUnavailableStatus": {
        "type": "string",
        "enum": [
          "unavailable"
        ]
      },
      "CapabilityUnavailableReason": {
        "type": "string",
        "enum": [
          "not_requested"
        ]
      },
      "CapabilityUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/$defs/CapabilityUnavailableStatus",
            "default": "unavailable"
          },
          "reason": {
            "$ref": "#/$defs/CapabilityUnavailableReason",
            "default": "not_requested"
          },
          "capability": {
            "type": "string"
          },
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          }
        },
        "required": [
          "status",
          "reason",
          "capability",
          "snapshot_id",
          "generation"
        ]
      }
    },
    "type": "object"
  },
  "search_operations.input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SearchOperationsRequest",
    "type": "object",
    "properties": {
      "library": {
        "$ref": "#/$defs/Text1To500"
      },
      "query": {
        "$ref": "#/$defs/Text1To4000"
      },
      "where": {
        "anyOf": [
          {
            "$ref": "#/$defs/Where"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "limit": {
        "$ref": "#/$defs/Limit10Default5",
        "default": 5
      }
    },
    "additionalProperties": false,
    "required": [
      "library",
      "query"
    ],
    "$defs": {
      "Text1To500": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "Text1To4000": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "Where": {
        "type": "object",
        "properties": {
          "facets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/FacetTerm"
            },
            "maxItems": 10,
            "default": []
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/OperationKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "path_prefix": {
            "anyOf": [
              {
                "$ref": "#/$defs/Text0To500"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "FacetTerm": {
        "type": "object",
        "properties": {
          "facet": {
            "$ref": "#/$defs/FacetName"
          },
          "value": {
            "$ref": "#/$defs/Text1To500"
          }
        },
        "additionalProperties": false,
        "required": [
          "facet",
          "value"
        ]
      },
      "FacetName": {
        "type": "string",
        "enum": [
          "parameter",
          "parameter_type",
          "returns",
          "raises",
          "decorator",
          "async",
          "delegates_to",
          "forwards_to",
          "hands_off_to",
          "takes_from",
          "module",
          "kind",
          "reads_setting"
        ]
      },
      "OperationKind": {
        "type": "string",
        "enum": [
          "function",
          "method",
          "class"
        ]
      },
      "Text0To500": {
        "type": "string",
        "minLength": 0,
        "maxLength": 500
      },
      "Limit10Default5": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    }
  },
  "search_operations.output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SearchOperationsResponse",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "result_kind": {
            "type": "string",
            "const": "results"
          }
        },
        "$ref": "#/$defs/OperationHits",
        "required": [
          "result_kind"
        ]
      }
    ],
    "$defs": {
      "RetrievalMetadata": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "requested_route": {
            "$ref": "#/$defs/RetrievalMetadataRequestedRoute"
          },
          "actual_route": {
            "$ref": "#/$defs/RetrievalMetadataActualRoute"
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "candidate_depth": {
            "type": "integer",
            "format": "int64",
            "default": 0
          },
          "approximate": {
            "type": "boolean",
            "default": false
          },
          "routing_reason": {
            "type": "string",
            "default": "explicit_profile"
          },
          "admission": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "profile",
          "requested_route",
          "actual_route",
          "fallback",
          "candidate_depth",
          "approximate",
          "routing_reason",
          "admission"
        ]
      },
      "RetrievalMetadataRequestedRoute": {
        "type": "string",
        "enum": [
          "exact",
          "hnsw",
          "mixed"
        ]
      },
      "RetrievalMetadataActualRoute": {
        "type": "string",
        "enum": [
          "exact",
          "hnsw",
          "lexical-only"
        ]
      },
      "SnapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "GenerationDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F]{64}$"
      },
      "OperationHitsMode": {
        "type": "string",
        "enum": [
          "hybrid",
          "lexical-only"
        ]
      },
      "Nullablestring": {
        "type": [
          "string",
          "null"
        ]
      },
      "OperationHit": {
        "type": "object",
        "properties": {
          "operation_id": {
            "$ref": "#/$defs/OperationId"
          },
          "access_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "docstring_summary": {
            "$ref": "#/$defs/Nullablestring"
          },
          "relevance": {
            "type": "number",
            "format": "double"
          },
          "rank_source": {
            "type": "string"
          },
          "promoted": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "access_path",
          "kind",
          "docstring_summary",
          "relevance",
          "rank_source",
          "promoted"
        ]
      },
      "OperationId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "OperationHits": {
        "type": "object",
        "properties": {
          "retrieval": {
            "$ref": "#/$defs/RetrievalMetadata"
          },
          "snapshot_id": {
            "$ref": "#/$defs/SnapshotId"
          },
          "generation": {
            "$ref": "#/$defs/GenerationDigest"
          },
          "mode": {
            "$ref": "#/$defs/OperationHitsMode"
          },
          "degraded_reason": {
            "$ref": "#/$defs/Nullablestring"
          },
          "ranked_discovery": {
            "type": "boolean"
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OperationHit"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "retrieval",
          "snapshot_id",
          "generation",
          "mode",
          "degraded_reason",
          "ranked_discovery",
          "hits",
          "note"
        ]
      }
    },
    "type": "object"
  }
}
