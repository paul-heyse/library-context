---
table catalog_spans
family findings
key snapshot_id, span_id
check span: start_byte >= 0 AND end_byte >= start_byte
@lctx.family=findings
@lctx.table=catalog_spans
snapshot_id: FixedSizeBinary(16) NOT NULL
span_id: FixedSizeBinary(16) NOT NULL
artifact_id: FixedSizeBinary(16) NOT NULL
start_byte: Int64 NOT NULL
end_byte: Int64 NOT NULL
extraction: Utf8 NOT NULL
