---
table modeled_callback_sites
family findings
key snapshot_id, call_site_node_id, pysa_fact_id, model_id, rule_id
@lctx.family=findings
@lctx.table=modeled_callback_sites
snapshot_id: FixedSizeBinary(16) NOT NULL
call_site_node_id: FixedSizeBinary(16) NOT NULL
function_node_id: FixedSizeBinary(16) NULL
call_fact_id: FixedSizeBinary(16) NOT NULL
pysa_fact_id: FixedSizeBinary(16) NOT NULL
target_node_id: FixedSizeBinary(16) NOT NULL
model_id: FixedSizeBinary(16) NOT NULL
rule_id: FixedSizeBinary(16) NOT NULL
target_definition_fact_id: FixedSizeBinary(16) NOT NULL
callback_path_id: FixedSizeBinary(16) NOT NULL
argument_node_id: FixedSizeBinary(16) NULL
argument_fact_id: FixedSizeBinary(16) NULL
binding_status: Int16 NOT NULL [lctx.codebook=model_argument_status]
binding_reason: Int16 NULL [lctx.codebook=boundary_reason]
action: Int16 NOT NULL [lctx.codebook=model_callback_action]
exit: Int16 NOT NULL [lctx.codebook=model_exit]
target_modality: Int16 NOT NULL [lctx.codebook=modality]
model_modality: Int16 NOT NULL [lctx.codebook=modality]
candidate_set_complete_under_model: Boolean NOT NULL
has_unresolved_remainder: Boolean NOT NULL
origin: Int16 NOT NULL [lctx.codebook=origin]
