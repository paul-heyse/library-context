id:arguments
  SELECT node_id FROM arguments WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('argument', call_node_id, ordinal) AS BYTEA)
id:context_definitions
  SELECT symbol_node_id FROM context_definitions WHERE CAST(symbol_node_id AS BYTEA) <> CAST(lctx_id('external_symbol', module_node_id, kind, key) AS BYTEA)
id:scopes
  SELECT node_id FROM scopes WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('scope', owner_node_id) AS BYTEA)
id:bindings
  SELECT node_id FROM bindings WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('binding', site_node_id, name) AS BYTEA)
id:references
  SELECT node_id FROM references WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('reference', name_node_id) AS BYTEA)
id:record_fields
  SELECT node_id FROM record_fields WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('field', class_node_id, name) AS BYTEA)
id:documents
  SELECT node_id FROM documents WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('document', release_id, path) AS BYTEA)
id:passages
  SELECT node_id FROM passages WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('passage', document_node_id, ordinal) AS BYTEA)
id:code_blocks
  SELECT node_id FROM code_blocks WHERE CAST(node_id AS BYTEA) <> CAST(lctx_id('code_block', document_node_id, ordinal) AS BYTEA)
id:context_modules
  SELECT module_node_id FROM context_modules WHERE distribution IS NOT NULL AND CAST(module_node_id AS BYTEA) <> CAST(lctx_id('external_module', distribution, version, module_name) AS BYTEA)
partition:pysa_calls-gaps
  SELECT g.gap_fact_id FROM graph_gaps g LEFT ANTI JOIN pysa_calls p ON p.fact_id = g.gap_fact_id WHERE g.table_name = 'pysa_calls'
partition:pysa_calls-remainders
  WITH rem AS ( SELECT p.fact_id, p.higher_order_index, c.node_id AS call_node_id FROM pysa_calls p LEFT JOIN call_syntax c ON c.module_node_id = p.module_node_id AND c.start_byte = p.start_byte AND c.end_byte = p.end_byte WHERE site_kind = 0 AND callee_kind = 0 AND p.target_kind = 2), counted AS ( SELECT call_site_node_id AS call_node_id, CAST(NULL AS BIGINT) AS ordinal FROM resolutions WHERE has_unresolved_remainder UNION ALL SELECT a.call_node_id, a.ordinal FROM argument_resolutions x JOIN arguments a ON a.node_id = x.argument_node_id WHERE x.has_unresolved_remainder) SELECT r.fact_id FROM rem r LEFT ANTI JOIN counted k ON k.call_node_id = r.call_node_id AND ((r.higher_order_index IS NULL AND k.ordinal IS NULL) OR k.ordinal = r.higher_order_index)
placed:declarations
  SELECT d.fact_id FROM declarations d LEFT ANTI JOIN syntax_nodes s ON s.node_id = d.node_id
placed:call_syntax
  SELECT c.fact_id FROM call_syntax c LEFT ANTI JOIN syntax_nodes s ON s.node_id = c.node_id WHERE NOT c.in_annotation
unique:syntax_nodes
  SELECT node_id, count(*) AS n FROM syntax_nodes GROUP BY node_id HAVING count(*) > 1
contained:syntax_nodes
  SELECT c.node_id FROM syntax_nodes c JOIN syntax_nodes p ON p.node_id = c.parent_node_id WHERE c.start_byte < p.start_byte OR c.end_byte > p.end_byte OR c.module_node_id <> p.module_node_id
unique:type_terms
  SELECT node_id FROM type_terms GROUP BY node_id HAVING count(DISTINCT kind) > 1 OR count(DISTINCT display) > 1 OR count(DISTINCT COALESCE(detail, '')) > 1
unique:release-paths
  SELECT path, count(DISTINCT release_id) AS n FROM source_files GROUP BY path HAVING count(DISTINCT release_id) > 1
support:edges
  SELECT e.edge_id FROM edges e LEFT ANTI JOIN facts f ON f.fact_id = e.support_fact_id WHERE e.support_fact_id IS NOT NULL
typed:call_targets
  SELECT * FROM call_targets WHERE target_node_id IS NULL AND reason IS NULL
typed:ancestry_targets
  SELECT * FROM ancestry_targets WHERE (class_node_id IS NULL OR ancestor_node_id IS NULL) AND reason IS NULL
typed:override_targets
  SELECT * FROM override_targets WHERE (function_node_id IS NULL OR overridden_node_id IS NULL) AND reason IS NULL
typed:exports
  SELECT * FROM exports WHERE target_node_id IS NULL AND reason IS NULL
typed:site_targets
  SELECT * FROM site_targets WHERE (site_node_id IS NULL OR target_node_id IS NULL) AND reason IS NULL
typed:identifier_targets
  SELECT * FROM identifier_targets WHERE (reference_node_id IS NULL OR target_node_id IS NULL) AND reason IS NULL
typed:import_targets
  SELECT * FROM import_targets WHERE target_node_id IS NULL AND reason IS NULL
typed:reference_resolutions
  SELECT * FROM reference_resolutions WHERE binding_id IS NULL AND builtin_name IS NULL AND reason IS NULL
typed:type_class_targets
  SELECT * FROM type_class_targets WHERE class_node_id IS NULL AND reason IS NULL
typed:type_binders
  SELECT * FROM type_binders WHERE binder_node_id IS NULL AND reason IS NULL
typed:mention_targets
  SELECT * FROM mention_targets WHERE target_node_id IS NULL AND reason IS NULL
