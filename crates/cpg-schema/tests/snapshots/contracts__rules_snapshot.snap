finite:analysis_invocations.residual
  SELECT v FROM (SELECT residual AS v FROM analysis_invocations) x WHERE v IS NOT NULL AND (isnan(v) OR abs(v) = CAST('Infinity' AS DOUBLE))
finite:analysis_invocations.quality_history
