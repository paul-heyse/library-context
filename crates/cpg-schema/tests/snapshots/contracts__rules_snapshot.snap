---
source: crates/cpg-schema/tests/contracts.rs
expression: "text.join(\"\\n\")"
---
key:facts
  SELECT snapshot_id, fact_id, count(*) AS n FROM facts GROUP BY snapshot_id, fact_id HAVING count(*) > 1
key:runs
  SELECT snapshot_id, run_id, count(*) AS n FROM runs GROUP BY snapshot_id, run_id HAVING count(*) > 1
key:contexts
  SELECT snapshot_id, context_id, count(*) AS n FROM contexts GROUP BY snapshot_id, context_id HAVING count(*) > 1
key:producers
  SELECT snapshot_id, producer_id, count(*) AS n FROM producers GROUP BY snapshot_id, producer_id HAVING count(*) > 1
key:releases
  SELECT snapshot_id, release_id, count(*) AS n FROM releases GROUP BY snapshot_id, release_id HAVING count(*) > 1
key:distributions
  SELECT snapshot_id, release_id, name, count(*) AS n FROM distributions GROUP BY snapshot_id, release_id, name HAVING count(*) > 1
key:source_files
  SELECT snapshot_id, module_name, path, fact_id, count(*) AS n FROM source_files GROUP BY snapshot_id, module_name, path, fact_id HAVING count(*) > 1
key:declarations
  SELECT snapshot_id, module_node_id, start_byte, end_byte, node_id, count(*) AS n FROM declarations GROUP BY snapshot_id, module_node_id, start_byte, end_byte, node_id HAVING count(*) > 1
key:export_syntax
  SELECT snapshot_id, module_node_id, start_byte, end_byte, fact_id, count(*) AS n FROM export_syntax GROUP BY snapshot_id, module_node_id, start_byte, end_byte, fact_id HAVING count(*) > 1
key:public_names
  SELECT snapshot_id, access_path, fact_id, count(*) AS n FROM public_names GROUP BY snapshot_id, access_path, fact_id HAVING count(*) > 1
key:parameter_syntax
  SELECT snapshot_id, function_node_id, ordinal, fact_id, count(*) AS n FROM parameter_syntax GROUP BY snapshot_id, function_node_id, ordinal, fact_id HAVING count(*) > 1
key:pysa_functions
  SELECT snapshot_id, module_node_id, function_key, fact_id, count(*) AS n FROM pysa_functions GROUP BY snapshot_id, module_node_id, function_key, fact_id HAVING count(*) > 1
key:parameter_semantics
  SELECT snapshot_id, module_node_id, function_key, signature_index, ordinal, fact_id, count(*) AS n FROM parameter_semantics GROUP BY snapshot_id, module_node_id, function_key, signature_index, ordinal, fact_id HAVING count(*) > 1
key:class_ancestry
  SELECT snapshot_id, module_node_id, class_key, relation, ordinal, fact_id, count(*) AS n FROM class_ancestry GROUP BY snapshot_id, module_node_id, class_key, relation, ordinal, fact_id HAVING count(*) > 1
key:call_syntax
  SELECT snapshot_id, module_node_id, start_byte, end_byte, node_id, count(*) AS n FROM call_syntax GROUP BY snapshot_id, module_node_id, start_byte, end_byte, node_id HAVING count(*) > 1
key:arguments
  SELECT snapshot_id, call_node_id, ordinal, fact_id, count(*) AS n FROM arguments GROUP BY snapshot_id, call_node_id, ordinal, fact_id HAVING count(*) > 1
key:pysa_calls
  SELECT snapshot_id, module_node_id, start_byte, end_byte, fact_id, count(*) AS n FROM pysa_calls GROUP BY snapshot_id, module_node_id, start_byte, end_byte, fact_id HAVING count(*) > 1
key:coverage
  SELECT snapshot_id, run_id, scope_node_id, fact_family, count(*) AS n FROM coverage GROUP BY snapshot_id, run_id, scope_node_id, fact_family HAVING count(*) > 1
key:boundaries
  SELECT snapshot_id, module_node_id, fact_family, start_byte, fact_id, count(*) AS n FROM boundaries GROUP BY snapshot_id, module_node_id, fact_family, start_byte, fact_id HAVING count(*) > 1
key:provider_node_map
  SELECT snapshot_id, module_node_id, function_key, count(*) AS n FROM provider_node_map GROUP BY snapshot_id, module_node_id, function_key HAVING count(*) > 1
key:exports
