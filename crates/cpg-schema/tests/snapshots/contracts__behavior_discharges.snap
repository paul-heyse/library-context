---
source: crates/cpg-schema/tests/contracts.rs
expression: text
---
table behavior_discharges
family findings
key snapshot_id, behavior_id, origin_id
check decision_shape: (decision = 0 AND summary_id IS NOT NULL AND reason IS NULL) OR (decision = 1 AND summary_id IS NULL AND reason IS NOT NULL)
@lctx.family=findings
@lctx.table=behavior_discharges
snapshot_id: FixedSizeBinary(16) NOT NULL
behavior_id: FixedSizeBinary(16) NOT NULL
origin_id: FixedSizeBinary(16) NOT NULL
proof_kind: Int16 NOT NULL [lctx.codebook=discharge_proof_kind]
decision: Int16 NOT NULL [lctx.codebook=discharge_decision]
summary_id: FixedSizeBinary(16) NULL
reason: Int16 NULL [lctx.codebook=boundary_reason]
