---
source: crates/cpg-schema/tests/contracts.rs
expression: text
---
table summary_origin_coverage
family findings
key snapshot_id, subject_kind, subject_id, condition_id, channel, phase
check coverage_shape: (complete AND reason IS NULL) OR (NOT complete AND reason IS NOT NULL)
check subject_shape: (subject_kind = 0 AND parameter_node_id IS NOT NULL) OR (subject_kind = 1 AND parameter_node_id IS NULL)
check subject_channel: (subject_kind = 0 AND channel = 1) OR (subject_kind = 1 AND channel IN (0, 4))
check witness_count_nonnegative: witness_count >= 0
@lctx.family=findings
@lctx.table=summary_origin_coverage
snapshot_id: FixedSizeBinary(16) NOT NULL
function_node_id: FixedSizeBinary(16) NOT NULL
subject_kind: Int16 NOT NULL [lctx.codebook=summary_subject_kind]
subject_id: FixedSizeBinary(16) NOT NULL
source_fact_id: FixedSizeBinary(16) NOT NULL
parameter_node_id: FixedSizeBinary(16) NULL
condition_id: FixedSizeBinary(16) NOT NULL
channel: Int16 NOT NULL [lctx.codebook=summary_channel]
phase: Int16 NOT NULL [lctx.codebook=invocation_phase]
complete: Boolean NOT NULL
reason: Int16 NULL [lctx.codebook=boundary_reason]
witness_count: Int64 NOT NULL
witnesses_omitted: Boolean NOT NULL
