---
source: crates/cpg-schema/tests/contracts.rs
expression: "text.join(\"\\n\")"
---
-- provider_node_map
SELECT f.module_node_id, f.function_key, d.node_id AS node_id, f.fact_id AS pysa_fact_id, d.fact_id AS declaration_fact_id, CAST(CASE WHEN d.node_id IS NOT NULL THEN NULL WHEN f.name_start_byte IS NULL THEN 13 ELSE 9 END AS SMALLINT) AS reason FROM pysa_functions f LEFT JOIN declarations d ON d.module_node_id = f.module_node_id AND d.name_start_byte = f.name_start_byte AND d.name_end_byte = f.name_end_byte

-- provider_class_map
SELECT c.module_node_id, c.class_key, d.node_id AS node_id, c.fact_id AS pysa_fact_id, d.fact_id AS declaration_fact_id, CAST(CASE WHEN d.node_id IS NOT NULL THEN NULL WHEN c.is_synthesized THEN 13 ELSE 9 END AS SMALLINT) AS reason FROM pysa_classes c LEFT JOIN declarations d ON d.module_node_id = c.module_node_id AND d.kind = 2 AND d.name_start_byte = c.name_start_byte AND d.name_end_byte = c.name_end_byte

-- synthetic_callables
SELECT lctx_id('synthetic_callable', module_node_id, function_key) AS node_id, module_node_id, function_key, pysa_fact_id FROM provider_node_map WHERE node_id IS NULL AND reason = 13

-- exports
WITH keyed AS (SELECT DISTINCT node_id FROM provider_node_map WHERE node_id IS NOT NULL), ranked AS ( SELECT d.node_id, d.fact_id, d.module_node_id, d.qualified_name, row_number() OVER (PARTITION BY d.module_node_id, d.qualified_name ORDER BY d.is_overload, k.node_id IS NULL, d.start_byte DESC, d.node_id) AS pick FROM declarations d LEFT JOIN keyed k ON k.node_id = d.node_id), ext AS ( SELECT m.module_name, d.name, d.symbol_node_id, row_number() OVER (PARTITION BY m.module_name, d.name ORDER BY d.kind, d.key) AS pick FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.is_top_level), release_modules AS ( SELECT module_name, module_node_id, row_number() OVER (PARTITION BY module_name ORDER BY is_stub, path) AS pick FROM source_files), dependency_modules AS ( SELECT DISTINCT module_name, module_node_id FROM context_modules WHERE origin <> 7), module_bindings AS ( SELECT b.module_node_id, b.name, b.node_id, row_number() OVER (PARTITION BY b.module_node_id, b.name ORDER BY b.ordinal DESC) AS pick FROM bindings b JOIN scopes s ON s.node_id = b.scope_id AND s.kind = 0 WHERE b.kind NOT IN (15, 16, 17, 11)), release AS ( SELECT f.fact_id, r.release_id FROM facts f JOIN runs r ON r.run_id = f.run_id WHERE f.table_name = 'public_names'), resolved AS ( SELECT p.access_path, x.release_id, p.fact_id AS public_fact_id, p.origin_path, p.origin_symbol_kind, p.origin_module_node_id, r.node_id AS declaration_node_id, r.fact_id AS declaration_fact_id, COALESCE(r.node_id, CASE WHEN p.origin_module_node_id IS NULL THEN e.symbol_node_id END, CASE WHEN p.origin_symbol_kind IN (1, 2, 3, 4, 5, 6) THEN mb.node_id END, CASE WHEN p.origin_symbol_kind IS NULL OR p.origin_symbol_kind = 0 THEN COALESCE(sm.module_node_id, dm.module_node_id) END) AS target_node_id FROM public_names p JOIN release x ON x.fact_id = p.fact_id LEFT JOIN ranked r ON r.pick = 1 AND r.module_node_id = p.origin_module_node_id AND r.qualified_name = p.origin_path LEFT JOIN ext e ON e.pick = 1 AND p.origin_module_node_id IS NULL AND e.module_name = p.origin_module AND e.name = p.origin_name LEFT JOIN module_bindings mb ON mb.pick = 1 AND mb.module_node_id = p.origin_module_node_id AND mb.name = p.origin_name LEFT JOIN release_modules sm ON sm.pick = 1 AND sm.module_name = p.origin_path LEFT JOIN dependency_modules dm ON sm.module_name IS NULL AND dm.module_name = p.origin_path) SELECT access_path, lctx_id('export', release_id, access_path) AS export_node_id, declaration_node_id, target_node_id, public_fact_id, declaration_fact_id, CAST(CASE WHEN target_node_id IS NOT NULL THEN NULL WHEN origin_path IS NULL OR origin_symbol_kind IS NULL THEN 7 WHEN origin_symbol_kind IN (1, 2, 3, 4, 5, 6) AND origin_module_node_id IS NULL THEN 15 END AS SMALLINT) AS reason FROM resolved

-- signatures
WITH keyed AS ( SELECT node_id, MIN(function_key) AS function_key FROM provider_node_map WHERE node_id IS NOT NULL GROUP BY node_id), fn AS ( SELECT d.node_id, d.fact_id, d.module_node_id, d.qualified_name, d.is_overload, d.start_byte, k.function_key FROM declarations d LEFT JOIN keyed k ON k.node_id = d.node_id WHERE d.kind IN (0, 1)), next_start AS ( SELECT s.node_id, MIN(i.start_byte) AS start_byte FROM fn s JOIN fn i ON i.module_node_id = s.module_node_id AND i.qualified_name = s.qualified_name AND i.start_byte > s.start_byte AND (NOT i.is_overload OR i.function_key IS NOT NULL) WHERE s.is_overload AND s.function_key IS NULL GROUP BY s.node_id), last_stub AS ( SELECT module_node_id, qualified_name, MAX(start_byte) AS start_byte FROM fn WHERE is_overload GROUP BY module_node_id, qualified_name), owned AS ( SELECT s.node_id, s.fact_id, s.module_node_id, s.qualified_name, s.is_overload, s.start_byte, CASE WHEN s.is_overload AND s.function_key IS NULL THEN COALESCE(n.start_byte, l.start_byte) ELSE s.start_byte END AS callable_start FROM fn s LEFT JOIN next_start n ON n.node_id = s.node_id LEFT JOIN last_stub l ON l.module_node_id = s.module_node_id AND l.qualified_name = s.qualified_name), placed AS ( SELECT o.node_id, o.fact_id, o.module_node_id, o.qualified_name, o.is_overload, k.node_id AS callable_node_id, k.function_key, row_number() OVER (PARTITION BY o.module_node_id, o.qualified_name, o.callable_start, o.is_overload ORDER BY o.start_byte) - 1 AS stub_ordinal, SUM(CASE WHEN o.is_overload THEN 1 ELSE 0 END) OVER (PARTITION BY o.module_node_id, o.qualified_name, o.callable_start) AS stubs FROM owned o JOIN fn k ON k.module_node_id = o.module_node_id AND k.qualified_name = o.qualified_name AND k.start_byte = o.callable_start), described AS ( SELECT DISTINCT module_node_id, qualified_name FROM fn WHERE function_key IS NOT NULL), sig AS ( SELECT p.node_id, p.fact_id, p.module_node_id, p.callable_node_id, p.function_key, CASE WHEN p.function_key IS NULL THEN NULL WHEN p.is_overload AND p.stub_ordinal < f.signature_count THEN p.stub_ordinal WHEN NOT p.is_overload AND p.stubs = 0 AND f.signature_count > 0 THEN 0 END AS signature_index, CASE WHEN p.function_key IS NULL AND g.qualified_name IS NOT NULL THEN 14 WHEN p.function_key IS NULL THEN 7 WHEN p.is_overload AND p.stub_ordinal >= f.signature_count THEN 9 WHEN p.node_id = p.callable_node_id AND p.stubs > 0 AND p.stubs <> f.signature_count THEN 9 WHEN NOT p.is_overload AND p.stubs = 0 AND f.signature_count <> 1 THEN 9 END AS reason FROM placed p LEFT JOIN described g ON g.module_node_id = p.module_node_id AND g.qualified_name = p.qualified_name LEFT JOIN pysa_functions f ON f.module_node_id = p.module_node_id AND f.function_key = p.function_key), forms AS ( SELECT module_node_id, function_key, signature_index, MIN(form) AS form FROM parameter_semantics WHERE ordinal IS NULL GROUP BY module_node_id, function_key, signature_index) SELECT s.node_id AS signature_node_id, s.callable_node_id, s.module_node_id, s.function_key, s.signature_index, CAST(CASE WHEN s.signature_index IS NULL THEN NULL ELSE COALESCE(m.form, 0) END AS SMALLINT) AS form, s.fact_id AS declaration_fact_id, CAST(s.reason AS SMALLINT) AS reason FROM sig s LEFT JOIN forms m ON m.module_node_id = s.module_node_id AND m.function_key = s.function_key AND m.signature_index = s.signature_index

-- parameters
WITH syn AS ( SELECT s.signature_node_id, p.ordinal, p.fact_id, p.name, p.kind FROM signatures s JOIN parameter_syntax p ON p.function_node_id = s.signature_node_id), sem AS ( SELECT s.signature_node_id, q.ordinal, q.fact_id, q.name, q.kind FROM signatures s JOIN parameter_semantics q ON q.module_node_id = s.module_node_id AND q.function_key = s.function_key AND q.signature_index = s.signature_index AND q.ordinal IS NOT NULL), joined AS ( SELECT COALESCE(a.signature_node_id, b.signature_node_id) AS signature_node_id, COALESCE(a.ordinal, b.ordinal) AS ordinal, a.fact_id AS syntax_fact_id, b.fact_id AS semantics_fact_id, a.name AS syntax_name, b.name AS semantics_name, a.kind AS syntax_kind, b.kind AS semantics_kind FROM syn a FULL OUTER JOIN sem b ON a.signature_node_id = b.signature_node_id AND a.ordinal = b.ordinal) SELECT j.signature_node_id, j.ordinal, j.syntax_fact_id, j.semantics_fact_id, CAST(CASE WHEN j.syntax_fact_id IS NULL OR (j.semantics_fact_id IS NULL AND s.form = 0) OR j.syntax_name <> j.semantics_name OR j.syntax_kind <> j.semantics_kind THEN 9 END AS SMALLINT) AS reason FROM joined j JOIN signatures s ON s.signature_node_id = j.signature_node_id

-- resolutions
WITH hits AS ( SELECT c.node_id, p.target_kind, p.unresolved_reason FROM call_syntax c JOIN pysa_calls p ON p.module_node_id = c.module_node_id AND p.start_byte = c.start_byte AND p.end_byte = c.end_byte AND p.site_kind = 0 AND p.callee_kind = 0 AND p.higher_order_index IS NULL), agg AS ( SELECT c.node_id, c.fact_id, c.in_annotation, COUNT(h.target_kind) AS pysa_rows, SUM(CASE WHEN h.target_kind <> 2 THEN 1 ELSE 0 END) AS targets, SUM(CASE WHEN h.target_kind = 2 THEN 1 ELSE 0 END) AS remainders, SUM(CASE WHEN h.target_kind = 1 THEN 1 ELSE 0 END) AS overrides, MIN(h.unresolved_reason) AS unresolved_reason FROM call_syntax c LEFT JOIN hits h ON h.node_id = c.node_id GROUP BY c.node_id, c.fact_id, c.in_annotation) SELECT node_id AS call_site_node_id, CAST(CASE WHEN pysa_rows = 0 THEN 3 WHEN targets = 0 THEN 2 WHEN remainders > 0 THEN 1 ELSE 0 END AS SMALLINT) AS status, CAST(0 AS SMALLINT) AS domain, NOT (targets > 0 AND remainders = 0) AS has_unresolved_remainder, (targets > 0 AND remainders = 0 AND overrides = 0) AS candidate_set_complete_under_model, unresolved_reason, CAST(targets AS BIGINT) AS target_count, fact_id AS call_fact_id, CAST(CASE WHEN pysa_rows = 0 AND in_annotation THEN 10 WHEN pysa_rows = 0 THEN 7 END AS SMALLINT) AS reason FROM agg

-- argument_resolutions
WITH hits AS ( SELECT c.node_id AS call_node_id, p.higher_order_index, p.target_kind, p.unresolved_reason FROM call_syntax c JOIN pysa_calls p ON p.module_node_id = c.module_node_id AND p.start_byte = c.start_byte AND p.end_byte = c.end_byte AND p.site_kind = 0 AND p.callee_kind = 0 AND p.higher_order_index IS NOT NULL), agg AS ( SELECT a.node_id, SUM(CASE WHEN h.target_kind <> 2 THEN 1 ELSE 0 END) AS targets, SUM(CASE WHEN h.target_kind = 2 THEN 1 ELSE 0 END) AS remainders, MIN(h.unresolved_reason) AS unresolved_reason FROM hits h JOIN arguments a ON a.call_node_id = h.call_node_id AND a.ordinal = h.higher_order_index GROUP BY a.node_id) SELECT node_id AS argument_node_id, CAST(CASE WHEN targets = 0 THEN 2 WHEN remainders > 0 THEN 1 ELSE 0 END AS SMALLINT) AS status, remainders > 0 AS has_unresolved_remainder, unresolved_reason, CAST(targets AS BIGINT) AS target_count FROM agg

-- call_targets
WITH external_functions AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 0) SELECT c.node_id AS call_site_node_id, p.fact_id AS pysa_fact_id, a.node_id AS argument_node_id, COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) AS target_node_id, CAST(CASE WHEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) IS NOT NULL THEN NULL WHEN t_m.function_key IS NOT NULL THEN t_m.reason END AS SMALLINT) AS reason FROM call_syntax c JOIN pysa_calls p ON p.module_node_id = c.module_node_id AND p.start_byte = c.start_byte AND p.end_byte = c.end_byte AND p.site_kind = 0 AND p.callee_kind = 0 AND p.target_kind <> 2 LEFT JOIN arguments a ON a.call_node_id = c.node_id AND a.ordinal = p.higher_order_index LEFT JOIN source_files t_f ON p.target_module = '@' || t_f.path LEFT JOIN provider_node_map t_m ON t_m.module_node_id = t_f.module_node_id AND t_m.function_key = p.target_key LEFT JOIN synthetic_callables t_s ON t_s.module_node_id = t_f.module_node_id AND t_s.function_key = p.target_key LEFT JOIN external_functions t_e ON t_f.module_node_id IS NULL AND t_e.module_name = p.target_module AND t_e.key = p.target_key

-- ancestry_targets
WITH external_classes AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 1) SELECT a.fact_id AS ancestry_fact_id, s.node_id AS class_node_id, COALESCE(t.node_id, e.symbol_node_id) AS ancestor_node_id, CAST(CASE WHEN s.node_id IS NULL THEN s.reason WHEN COALESCE(t.node_id, e.symbol_node_id) IS NOT NULL THEN NULL WHEN t.class_key IS NOT NULL THEN t.reason END AS SMALLINT) AS reason FROM class_ancestry a JOIN provider_class_map s ON s.module_node_id = a.module_node_id AND s.class_key = a.class_key LEFT JOIN source_files f ON a.ancestor_module = '@' || f.path LEFT JOIN provider_class_map t ON t.module_node_id = f.module_node_id AND t.class_key = a.ancestor_key LEFT JOIN external_classes e ON f.module_node_id IS NULL AND e.module_name = a.ancestor_module AND e.key = a.ancestor_key WHERE a.ancestor_module IS NOT NULL

-- override_targets
WITH external_functions AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 0) SELECT p.fact_id AS function_fact_id, COALESCE(m.node_id, s.node_id) AS function_node_id, COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) AS overridden_node_id, CAST(CASE WHEN COALESCE(m.node_id, s.node_id) IS NULL THEN m.reason ELSE CASE WHEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) IS NOT NULL THEN NULL WHEN t_m.function_key IS NOT NULL THEN t_m.reason END END AS SMALLINT) AS reason FROM pysa_functions p JOIN provider_node_map m ON m.module_node_id = p.module_node_id AND m.function_key = p.function_key LEFT JOIN synthetic_callables s ON s.module_node_id = p.module_node_id AND s.function_key = p.function_key LEFT JOIN source_files t_f ON p.overridden_module = '@' || t_f.path LEFT JOIN provider_node_map t_m ON t_m.module_node_id = t_f.module_node_id AND t_m.function_key = p.overridden_key LEFT JOIN synthetic_callables t_s ON t_s.module_node_id = t_f.module_node_id AND t_s.function_key = p.overridden_key LEFT JOIN external_functions t_e ON t_f.module_node_id IS NULL AND t_e.module_name = p.overridden_module AND t_e.key = p.overridden_key WHERE p.overridden_module IS NOT NULL

-- site_targets
WITH external_functions AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 0), sites AS ( SELECT fact_id, module_node_id, start_byte, end_byte, target_kind, target_module, target_key FROM pysa_calls WHERE NOT (site_kind = 0 AND callee_kind = 0) AND callee_kind <> 1), exact AS ( SELECT s.fact_id, n.node_id, n.parent_node_id FROM sites s JOIN syntax_nodes n ON n.module_node_id = s.module_node_id AND n.start_byte = s.start_byte AND n.end_byte = s.end_byte), chained AS ( SELECT s.fact_id, n.node_id, n.parent_node_id FROM sites s LEFT ANTI JOIN exact e ON e.fact_id = s.fact_id JOIN syntax_nodes n ON n.module_node_id = s.module_node_id AND n.kind = 42 AND n.start_byte <= s.start_byte AND n.end_byte >= s.end_byte), candidates AS (SELECT * FROM exact UNION ALL SELECT * FROM chained), deepest AS ( SELECT c.fact_id, c.node_id, row_number() OVER (PARTITION BY c.fact_id ORDER BY c.node_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS pick FROM candidates c LEFT ANTI JOIN candidates d ON d.fact_id = c.fact_id AND d.parent_node_id = c.node_id) SELECT s.fact_id AS pysa_fact_id, x.node_id AS site_node_id, CASE WHEN s.target_kind <> 2 THEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) END AS target_node_id, CAST(CASE WHEN x.node_id IS NULL THEN NULL WHEN s.target_kind = 2 THEN 1 ELSE CASE WHEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) IS NOT NULL THEN NULL WHEN t_m.function_key IS NOT NULL THEN t_m.reason END END AS SMALLINT) AS reason FROM sites s LEFT JOIN deepest x ON x.fact_id = s.fact_id AND x.pick = 1 LEFT JOIN source_files t_f ON s.target_module = '@' || t_f.path LEFT JOIN provider_node_map t_m ON t_m.module_node_id = t_f.module_node_id AND t_m.function_key = s.target_key LEFT JOIN synthetic_callables t_s ON t_s.module_node_id = t_f.module_node_id AND t_s.function_key = s.target_key LEFT JOIN external_functions t_e ON t_f.module_node_id IS NULL AND t_e.module_name = s.target_module AND t_e.key = s.target_key

-- identifier_targets
WITH external_functions AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 0), sites AS ( SELECT fact_id, module_node_id, start_byte, end_byte, target_kind, target_module, target_key FROM pysa_calls WHERE NOT (site_kind = 0 AND callee_kind = 0) AND callee_kind = 1), hits AS ( SELECT s.fact_id, r.node_id, row_number() OVER (PARTITION BY s.fact_id ORDER BY r.node_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS pick FROM sites s JOIN references r ON r.module_node_id = s.module_node_id AND r.start_byte = s.start_byte AND r.end_byte = s.end_byte) SELECT s.fact_id AS pysa_fact_id, h.node_id AS reference_node_id, CASE WHEN s.target_kind <> 2 THEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) END AS target_node_id, CAST(CASE WHEN h.node_id IS NULL THEN NULL WHEN s.target_kind = 2 THEN 1 ELSE CASE WHEN COALESCE(t_m.node_id, t_s.node_id, t_e.symbol_node_id) IS NOT NULL THEN NULL WHEN t_m.function_key IS NOT NULL THEN t_m.reason END END AS SMALLINT) AS reason FROM sites s LEFT JOIN hits h ON h.fact_id = s.fact_id AND h.pick = 1 LEFT JOIN source_files t_f ON s.target_module = '@' || t_f.path LEFT JOIN provider_node_map t_m ON t_m.module_node_id = t_f.module_node_id AND t_m.function_key = s.target_key LEFT JOIN synthetic_callables t_s ON t_s.module_node_id = t_f.module_node_id AND t_s.function_key = s.target_key LEFT JOIN external_functions t_e ON t_f.module_node_id IS NULL AND t_e.module_name = s.target_module AND t_e.key = s.target_key

-- import_targets
WITH release_modules AS ( SELECT module_name, module_node_id, row_number() OVER (PARTITION BY module_name ORDER BY is_stub, path) AS pick FROM source_files), dependency_modules AS ( SELECT DISTINCT module_name, module_node_id, origin FROM context_modules) SELECT x.fact_id AS import_fact_id, x.module_node_id, COALESCE(r.module_node_id, CASE WHEN d.origin <> 7 THEN d.module_node_id END) AS target_node_id, CAST(CASE WHEN r.module_node_id IS NOT NULL THEN NULL WHEN x.resolved_module IS NULL OR d.origin = 7 THEN 1 END AS SMALLINT) AS reason FROM export_syntax x LEFT JOIN release_modules r ON r.pick = 1 AND r.module_name = x.resolved_module LEFT JOIN dependency_modules d ON r.module_name IS NULL AND d.module_name = x.resolved_module WHERE x.kind IN (0, 1)

-- type_class_targets
WITH external_classes AS (SELECT m.module_name, d.key, d.symbol_node_id FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE d.kind = 1) SELECT t.node_id AS term_node_id, t.fact_id AS term_fact_id, COALESCE(m.node_id, e.symbol_node_id) AS class_node_id, CAST(CASE WHEN COALESCE(m.node_id, e.symbol_node_id) IS NOT NULL THEN NULL WHEN m.class_key IS NOT NULL THEN m.reason END AS SMALLINT) AS reason FROM type_terms t LEFT JOIN source_files f ON t.class_module = '@' || f.path LEFT JOIN provider_class_map m ON m.module_node_id = f.module_node_id AND m.class_key = t.class_key LEFT JOIN external_classes e ON f.module_node_id IS NULL AND e.module_name = t.class_module AND e.key = t.class_key WHERE t.class_module IS NOT NULL

-- type_binders
WITH anchored AS ( SELECT DISTINCT node_id, fact_id, anchor_module, anchor_start, anchor_end FROM type_terms WHERE anchor_module IS NOT NULL), holders AS ( SELECT f.module_name, f.is_stub, d.node_id, d.start_byte, d.end_byte FROM declarations d JOIN source_files f ON f.module_node_id = d.module_node_id UNION ALL SELECT f.module_name, f.is_stub, s.node_id, s.start_byte, s.end_byte FROM syntax_nodes s JOIN source_files f ON f.module_node_id = s.module_node_id WHERE s.kind IN (6, 7, 9)), ranked AS ( SELECT a.node_id AS term_node_id, h.node_id AS binder_node_id, row_number() OVER (PARTITION BY a.node_id ORDER BY h.end_byte - h.start_byte, h.is_stub, h.node_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS pick FROM anchored a JOIN holders h ON h.module_name = a.anchor_module AND h.start_byte <= a.anchor_start AND a.anchor_end <= h.end_byte), release_modules AS (SELECT DISTINCT module_name FROM source_files) SELECT a.node_id AS term_node_id, a.fact_id AS term_fact_id, r.binder_node_id, CAST(CASE WHEN r.binder_node_id IS NULL AND m.module_name IS NULL THEN 5 END AS SMALLINT) AS reason FROM anchored a LEFT JOIN ranked r ON r.term_node_id = a.node_id AND r.pick = 1 LEFT JOIN release_modules m ON m.module_name = a.anchor_module

-- mention_targets
WITH keyed AS (SELECT DISTINCT node_id FROM provider_node_map WHERE node_id IS NOT NULL), exported AS (SELECT DISTINCT access_path, export_node_id FROM exports), ranked AS ( SELECT d.node_id, d.qualified_name, row_number() OVER (PARTITION BY d.qualified_name ORDER BY d.is_overload, k.node_id IS NULL, d.start_byte DESC, d.node_id) AS pick FROM declarations d LEFT JOIN keyed k ON k.node_id = d.node_id) SELECT m.fact_id AS mention_fact_id, m.passage_node_id, COALESCE(e.export_node_id, r.node_id) AS target_node_id, CAST(NULL AS SMALLINT) AS reason FROM mentions m LEFT JOIN exported e ON e.access_path = m.access_path LEFT JOIN ranked r ON r.pick = 1 AND r.qualified_name = m.qualified_name

-- nodes
SELECT node_id, node_kind, module_node_id, existence_fact_id FROM ( SELECT *, row_number() OVER (PARTITION BY node_id, node_kind ORDER BY existence_fact_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS pick FROM (SELECT CAST(node_id AS BYTEA) AS node_id, CAST(0 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT module_node_id AS node_id, module_node_id, fact_id AS existence_fact_id FROM source_files) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(1 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM declarations WHERE kind = 2) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(2 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM declarations WHERE kind IN (0, 1)) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(3 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT p.node_id, d.module_node_id, p.fact_id AS existence_fact_id FROM parameter_syntax p JOIN declarations d ON d.node_id = p.function_node_id) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(4 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM call_syntax) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(5 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT a.node_id, s.module_node_id, a.fact_id AS existence_fact_id FROM arguments a JOIN call_syntax s ON s.node_id = a.call_node_id) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(6 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT export_node_id AS node_id, CAST(NULL AS BYTEA) AS module_node_id, public_fact_id AS existence_fact_id FROM exports) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(7 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT module_node_id AS node_id, CAST(NULL AS BYTEA) AS module_node_id, fact_id AS existence_fact_id FROM context_modules WHERE origin <> 7) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(8 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT symbol_node_id AS node_id, module_node_id, fact_id AS existence_fact_id FROM context_definitions) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(9 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, pysa_fact_id AS existence_fact_id FROM synthetic_callables) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(10 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM syntax_nodes WHERE kind NOT IN (2, 3, 43)) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(11 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM scopes) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(12 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM bindings) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(13 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM references) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(14 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, CAST(NULL AS BYTEA) AS module_node_id, fact_id AS existence_fact_id FROM type_terms) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(15 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, module_node_id, fact_id AS existence_fact_id FROM record_fields) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(16 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, CAST(NULL AS BYTEA) AS module_node_id, fact_id AS existence_fact_id FROM documents) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(17 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, CAST(NULL AS BYTEA) AS module_node_id, fact_id AS existence_fact_id FROM passages) s UNION ALL SELECT CAST(node_id AS BYTEA) AS node_id, CAST(18 AS SMALLINT) AS node_kind, CAST(module_node_id AS BYTEA) AS module_node_id, CAST(existence_fact_id AS BYTEA) AS existence_fact_id FROM (SELECT node_id, CAST(NULL AS BYTEA) AS module_node_id, fact_id AS existence_fact_id FROM code_blocks) s) u) r WHERE pick = 1 OR node_kind NOT IN (6, 7, 8)

-- edges
WITH e AS (SELECT CAST(0 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(COALESCE(d.parent_node_id, d.module_node_id) AS BYTEA) AS src_node_id, CAST(d.node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(d.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM declarations d) k0 UNION ALL SELECT CAST(1 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(s.signature_node_id AS BYTEA) AS src_node_id, CAST(s.callable_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(s.declaration_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM signatures s WHERE s.signature_node_id <> s.callable_node_id) k1 UNION ALL SELECT CAST(2 AS SMALLINT) AS edge_kind, * FROM (WITH keyed AS (SELECT DISTINCT node_id FROM provider_node_map WHERE node_id IS NOT NULL), py AS ( SELECT d.node_id, d.fact_id, s.module_name, d.qualified_name, row_number() OVER (PARTITION BY s.module_name, d.qualified_name ORDER BY d.is_overload, k.node_id IS NULL, d.start_byte DESC, d.node_id) AS pick FROM declarations d JOIN source_files s ON s.module_node_id = d.module_node_id AND NOT s.is_stub LEFT JOIN keyed k ON k.node_id = d.node_id) SELECT CAST(d.node_id AS BYTEA) AS src_node_id, CAST(p.node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(d.fact_id AS BYTEA) AS evidence_fact_id, CAST(p.fact_id AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM declarations d JOIN source_files s ON s.module_node_id = d.module_node_id AND s.is_stub JOIN py p ON p.pick = 1 AND p.module_name = s.module_name AND p.qualified_name = d.qualified_name) k2 UNION ALL SELECT CAST(3 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(p.function_node_id AS BYTEA) AS src_node_id, CAST(p.node_id AS BYTEA) AS dst_node_id, CAST(p.ordinal AS BIGINT) AS ordinal, CAST(p.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM parameter_syntax p) k3 UNION ALL SELECT CAST(4 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(e.export_node_id AS BYTEA) AS src_node_id, CAST(e.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(e.public_fact_id AS BYTEA) AS evidence_fact_id, CAST(e.declaration_fact_id AS BYTEA) AS support_fact_id, CAST(p.access_module_node_id AS BYTEA) AS discriminator FROM exports e JOIN public_names p ON p.fact_id = e.public_fact_id WHERE e.target_node_id IS NOT NULL) k4 UNION ALL SELECT CAST(5 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(COALESCE(s.owner_node_id, s.module_node_id) AS BYTEA) AS src_node_id, CAST(s.node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(s.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM call_syntax s) k5 UNION ALL SELECT CAST(6 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(a.call_node_id AS BYTEA) AS src_node_id, CAST(a.node_id AS BYTEA) AS dst_node_id, CAST(a.ordinal AS BIGINT) AS ordinal, CAST(a.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM arguments a) k6 UNION ALL SELECT CAST(7 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.call_site_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.pysa_fact_id AS BYTEA) AS evidence_fact_id, CAST(s.fact_id AS BYTEA) AS support_fact_id, CAST(p.payload_id AS BYTEA) AS discriminator FROM call_targets t JOIN pysa_calls p ON p.fact_id = t.pysa_fact_id JOIN call_syntax s ON s.node_id = t.call_site_node_id WHERE p.higher_order_index IS NULL AND t.target_node_id IS NOT NULL) k7 UNION ALL SELECT CAST(8 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.argument_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.pysa_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(p.payload_id AS BYTEA) AS discriminator FROM call_targets t JOIN pysa_calls p ON p.fact_id = t.pysa_fact_id WHERE t.argument_node_id IS NOT NULL AND t.target_node_id IS NOT NULL) k8 UNION ALL SELECT CAST(9 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.class_node_id AS BYTEA) AS src_node_id, CAST(t.ancestor_node_id AS BYTEA) AS dst_node_id, CAST(a.ordinal AS BIGINT) AS ordinal, CAST(t.ancestry_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM ancestry_targets t JOIN class_ancestry a ON a.fact_id = t.ancestry_fact_id WHERE a.relation = 0 AND t.class_node_id IS NOT NULL AND t.ancestor_node_id IS NOT NULL) k9 UNION ALL SELECT CAST(10 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.class_node_id AS BYTEA) AS src_node_id, CAST(t.ancestor_node_id AS BYTEA) AS dst_node_id, CAST(a.ordinal AS BIGINT) AS ordinal, CAST(t.ancestry_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM ancestry_targets t JOIN class_ancestry a ON a.fact_id = t.ancestry_fact_id WHERE a.relation = 1 AND t.class_node_id IS NOT NULL AND t.ancestor_node_id IS NOT NULL) k10 UNION ALL SELECT CAST(11 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(o.function_node_id AS BYTEA) AS src_node_id, CAST(o.overridden_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(o.function_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM override_targets o WHERE o.function_node_id IS NOT NULL AND o.overridden_node_id IS NOT NULL) k11 UNION ALL SELECT CAST(12 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(d.symbol_node_id AS BYTEA) AS src_node_id, CAST(d.module_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(d.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM context_definitions d) k12 UNION ALL SELECT CAST(13 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(s.parent_node_id AS BYTEA) AS src_node_id, CAST(s.node_id AS BYTEA) AS dst_node_id, CAST(s.ordinal AS BIGINT) AS ordinal, CAST(s.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM syntax_nodes s) k13 UNION ALL SELECT CAST(14 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(a.node_id AS BYTEA) AS src_node_id, CAST(s.node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(a.fact_id AS BYTEA) AS evidence_fact_id, CAST(s.fact_id AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM arguments a JOIN syntax_nodes s ON s.parent_node_id = a.call_node_id AND s.field = 21 AND s.start_byte >= a.start_byte AND s.end_byte <= a.end_byte) k14 UNION ALL SELECT CAST(15 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.site_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.pysa_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(p.payload_id AS BYTEA) AS discriminator FROM site_targets t JOIN pysa_calls p ON p.fact_id = t.pysa_fact_id JOIN facts f ON f.fact_id = t.pysa_fact_id WHERE t.site_node_id IS NOT NULL AND t.target_node_id IS NOT NULL AND f.modality <> 2) k15 UNION ALL SELECT CAST(16 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(s.owner_node_id AS BYTEA) AS src_node_id, CAST(s.node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(s.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM scopes s) k16 UNION ALL SELECT CAST(17 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(s.node_id AS BYTEA) AS src_node_id, CAST(s.parent_scope_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(s.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM scopes s WHERE s.parent_scope_id IS NOT NULL) k17 UNION ALL SELECT CAST(18 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(b.scope_id AS BYTEA) AS src_node_id, CAST(b.node_id AS BYTEA) AS dst_node_id, CAST(b.ordinal AS BIGINT) AS ordinal, CAST(b.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM bindings b) k18 UNION ALL SELECT CAST(19 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(b.node_id AS BYTEA) AS src_node_id, CAST(b.site_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(b.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM bindings b JOIN nodes n ON n.node_id = b.site_node_id WHERE b.kind <> 20) k19 UNION ALL SELECT CAST(20 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(r.reference_id AS BYTEA) AS src_node_id, CAST(r.binding_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(r.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM reference_resolutions r WHERE r.binding_id IS NOT NULL AND NOT r.captured) k20 UNION ALL SELECT CAST(21 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(r.reference_id AS BYTEA) AS src_node_id, CAST(r.binding_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(r.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM reference_resolutions r WHERE r.binding_id IS NOT NULL AND r.captured) k21 UNION ALL SELECT CAST(22 AS SMALLINT) AS edge_kind, * FROM (WITH builtins AS ( SELECT d.name, d.symbol_node_id, row_number() OVER (PARTITION BY d.name ORDER BY d.kind, d.key) AS pick FROM context_definitions d JOIN context_modules m ON m.module_node_id = d.module_node_id WHERE m.module_name = 'builtins' AND d.is_top_level) SELECT CAST(r.reference_id AS BYTEA) AS src_node_id, CAST(b.symbol_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(r.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM reference_resolutions r JOIN builtins b ON b.pick = 1 AND b.name = r.builtin_name WHERE r.reason IS NULL) k22 UNION ALL SELECT CAST(23 AS SMALLINT) AS edge_kind, * FROM (WITH ordered AS ( SELECT node_id, fact_id, lag(node_id) OVER (PARTITION BY scope_id, name ORDER BY ordinal) AS previous FROM bindings) SELECT CAST(o.node_id AS BYTEA) AS src_node_id, CAST(o.previous AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(o.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM ordered o WHERE o.previous IS NOT NULL) k23 UNION ALL SELECT CAST(24 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.reference_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.pysa_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(p.payload_id AS BYTEA) AS discriminator FROM identifier_targets t JOIN pysa_calls p ON p.fact_id = t.pysa_fact_id WHERE t.reference_node_id IS NOT NULL AND t.target_node_id IS NOT NULL UNION ALL SELECT CAST(t.site_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.pysa_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(p.payload_id AS BYTEA) AS discriminator FROM site_targets t JOIN pysa_calls p ON p.fact_id = t.pysa_fact_id JOIN facts f ON f.fact_id = t.pysa_fact_id WHERE t.site_node_id IS NOT NULL AND t.target_node_id IS NOT NULL AND f.modality = 2) k24 UNION ALL SELECT CAST(25 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.module_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.import_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(x.node_id AS BYTEA) AS discriminator FROM import_targets t JOIN export_syntax x ON x.fact_id = t.import_fact_id WHERE t.target_node_id IS NOT NULL) k25 UNION ALL SELECT CAST(26 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(o.subject_node_id AS BYTEA) AS src_node_id, CAST(o.term_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(o.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM type_observations o) k26 UNION ALL SELECT CAST(27 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(a.parent_node_id AS BYTEA) AS src_node_id, CAST(a.child_node_id AS BYTEA) AS dst_node_id, CAST(a.ordinal AS BIGINT) AS ordinal, CAST(a.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(lctx_id('type_arg_role', a.role) AS BYTEA) AS discriminator FROM type_term_args a) k27 UNION ALL SELECT CAST(28 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.term_node_id AS BYTEA) AS src_node_id, CAST(t.class_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(t.term_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM type_class_targets t WHERE t.class_node_id IS NOT NULL) k28 UNION ALL SELECT CAST(29 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(r.class_node_id AS BYTEA) AS src_node_id, CAST(r.node_id AS BYTEA) AS dst_node_id, CAST(r.ordinal AS BIGINT) AS ordinal, CAST(r.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM record_fields r) k29 UNION ALL SELECT CAST(30 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(r.node_id AS BYTEA) AS src_node_id, CAST(r.term_node_id AS BYTEA) AS dst_node_id, CAST(NULL AS BIGINT) AS ordinal, CAST(r.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM record_fields r) k30 UNION ALL SELECT CAST(31 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(p.document_node_id AS BYTEA) AS src_node_id, CAST(p.node_id AS BYTEA) AS dst_node_id, CAST(p.ordinal AS BIGINT) AS ordinal, CAST(p.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM passages p) k31 UNION ALL SELECT CAST(32 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(b.passage_node_id AS BYTEA) AS src_node_id, CAST(b.node_id AS BYTEA) AS dst_node_id, CAST(b.ordinal AS BIGINT) AS ordinal, CAST(b.fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM code_blocks b) k32 UNION ALL SELECT CAST(33 AS SMALLINT) AS edge_kind, * FROM (SELECT CAST(t.passage_node_id AS BYTEA) AS src_node_id, CAST(t.target_node_id AS BYTEA) AS dst_node_id, CAST(m.start_byte AS BIGINT) AS ordinal, CAST(t.mention_fact_id AS BYTEA) AS evidence_fact_id, CAST(NULL AS BYTEA) AS support_fact_id, CAST(NULL AS BYTEA) AS discriminator FROM mention_targets t JOIN mentions m ON m.fact_id = t.mention_fact_id WHERE t.target_node_id IS NOT NULL) k33) SELECT lctx_id('edge', e.edge_kind, e.src_node_id, e.dst_node_id, e.ordinal, e.discriminator) AS edge_id, e.edge_kind, e.src_node_id, s.node_kind AS src_kind, e.dst_node_id, t.node_kind AS dst_kind, e.ordinal, e.evidence_fact_id, e.support_fact_id FROM e LEFT JOIN nodes s ON s.node_id = e.src_node_id LEFT JOIN nodes t ON t.node_id = e.dst_node_id

-- graph_gaps
SELECT fact_id AS gap_fact_id, 'pysa_calls' AS table_name, CAST(8 AS SMALLINT) AS reason, 'identifier site: C3 lexical references' AS detail FROM pysa_calls WHERE NOT (site_kind = 0 AND callee_kind = 0) AND callee_kind = 1 AND FALSE

-- edge_kinds
SELECT CAST(0 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the module, class or function body defines the declaration' AS direction, false AS parallel, 'declarations' AS evidence_table, 'module,class,function' AS src_kinds, 'class,function' AS dst_kinds UNION ALL SELECT CAST(1 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the `@overload` stub describes a signature of the callable' AS direction, false AS parallel, 'declarations' AS evidence_table, 'function' AS src_kinds, 'function' AS dst_kinds UNION ALL SELECT CAST(2 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the `.pyi` declaration types the `.py` declaration of its module and name' AS direction, false AS parallel, 'declarations' AS evidence_table, 'class,function' AS src_kinds, 'class,function' AS dst_kinds UNION ALL SELECT CAST(3 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the `def` declares the parameter at the ordinal' AS direction, false AS parallel, 'parameter_syntax' AS evidence_table, 'function' AS src_kinds, 'parameter' AS dst_kinds UNION ALL SELECT CAST(4 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the public access path, read from one file, names the target' AS direction, true AS parallel, 'public_names' AS evidence_table, 'export' AS src_kinds, 'class,function,external_symbol,module,external_module,binding' AS dst_kinds UNION ALL SELECT CAST(5 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the call is in the module''s or declaration''s body (its owner)' AS direction, false AS parallel, 'call_syntax' AS evidence_table, 'module,class,function' AS src_kinds, 'call_site' AS dst_kinds UNION ALL SELECT CAST(6 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the call passes the argument at the ordinal (source order)' AS direction, false AS parallel, 'arguments' AS evidence_table, 'call_site' AS src_kinds, 'argument' AS dst_kinds UNION ALL SELECT CAST(7 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the call site may invoke the target (phase, receiver and modality on the evidence row)' AS direction, true AS parallel, 'pysa_calls' AS evidence_table, 'call_site' AS src_kinds, 'function,synthetic_callable,external_symbol' AS dst_kinds UNION ALL SELECT CAST(8 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the argument''s value may be invoked as the target (`potential`)' AS direction, true AS parallel, 'pysa_calls' AS evidence_table, 'argument' AS src_kinds, 'function,synthetic_callable,external_symbol' AS dst_kinds UNION ALL SELECT CAST(9 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the class lists the ancestor as a base, at the ordinal' AS direction, false AS parallel, 'class_ancestry' AS evidence_table, 'class' AS src_kinds, 'class,external_symbol' AS dst_kinds UNION ALL SELECT CAST(10 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the ancestor is at the ordinal of the class''s MRO as Pyrefly reports it (the class and `object` excluded)' AS direction, false AS parallel, 'class_ancestry' AS evidence_table, 'class' AS src_kinds, 'class,external_symbol' AS dst_kinds UNION ALL SELECT CAST(11 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the method overrides the base-class method' AS direction, false AS parallel, 'pysa_functions' AS evidence_table, 'function,synthetic_callable' AS src_kinds, 'function,synthetic_callable,external_symbol' AS dst_kinds UNION ALL SELECT CAST(12 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the dependency module defines the symbol' AS direction, false AS parallel, 'context_definitions' AS evidence_table, 'external_symbol' AS src_kinds, 'external_module' AS dst_kinds UNION ALL SELECT CAST(13 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the child is placed in the parent''s field at the ordinal (source order)' AS direction, false AS parallel, 'syntax_nodes' AS evidence_table, 'module,class,function,call_site,syntax_node' AS src_kinds, 'class,function,call_site,syntax_node' AS dst_kinds UNION ALL SELECT CAST(14 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the argument''s value is the placed expression' AS direction, false AS parallel, 'arguments' AS evidence_table, 'argument' AS src_kinds, 'call_site,syntax_node' AS dst_kinds UNION ALL SELECT CAST(15 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the site (an attribute access, an operator, a `for`/`with` protocol, a format string) may invoke the target (phase and modality on the evidence row; artificial sites are `synthetic_model`)' AS direction, true AS parallel, 'pysa_calls' AS evidence_table, 'syntax_node,call_site' AS src_kinds, 'function,synthetic_callable,external_symbol' AS dst_kinds UNION ALL SELECT CAST(16 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the module, declaration, lambda or comprehension opens the scope' AS direction, false AS parallel, 'scopes' AS evidence_table, 'module,class,function,syntax_node' AS src_kinds, 'scope' AS dst_kinds UNION ALL SELECT CAST(17 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the scope is nested in its parent scope' AS direction, false AS parallel, 'scopes' AS evidence_table, 'scope' AS src_kinds, 'scope' AS dst_kinds UNION ALL SELECT CAST(18 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the scope holds the binding event, at its ordinal (source order)' AS direction, false AS parallel, 'bindings' AS evidence_table, 'scope' AS src_kinds, 'binding' AS dst_kinds UNION ALL SELECT CAST(19 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the binding event is made by the declaration, parameter or placed statement' AS direction, false AS parallel, 'bindings' AS evidence_table, 'binding' AS src_kinds, 'class,function,parameter,syntax_node' AS dst_kinds UNION ALL SELECT CAST(20 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the name reads the binding event (flow-insensitive; `candidate` when several)' AS direction, false AS parallel, 'reference_resolutions' AS evidence_table, 'reference' AS src_kinds, 'binding' AS dst_kinds UNION ALL SELECT CAST(21 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the free name reads a binding of an enclosing function scope (a closure)' AS direction, false AS parallel, 'reference_resolutions' AS evidence_table, 'reference' AS src_kinds, 'binding' AS dst_kinds UNION ALL SELECT CAST(22 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the free name reads the builtin function or class' AS direction, false AS parallel, 'reference_resolutions' AS evidence_table, 'reference' AS src_kinds, 'external_symbol' AS dst_kinds UNION ALL SELECT CAST(23 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the binding event follows the previous event of its name in its scope' AS direction, false AS parallel, 'bindings' AS evidence_table, 'binding' AS src_kinds, 'binding' AS dst_kinds UNION ALL SELECT CAST(24 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the referenced callable value may be invoked as the target (`if_called`; `potential`)' AS direction, true AS parallel, 'pysa_calls' AS evidence_table, 'reference,syntax_node,call_site' AS src_kinds, 'function,synthetic_callable,external_symbol' AS dst_kinds UNION ALL SELECT CAST(25 AS SMALLINT) AS edge_kind, CAST(2 AS SMALLINT) AS derivation, 'the module imports the module (one edge per imported alias)' AS direction, true AS parallel, 'export_syntax' AS evidence_table, 'module' AS src_kinds, 'module,external_module' AS dst_kinds UNION ALL SELECT CAST(26 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the element has the type, in the role its observation states (§3.5.1)' AS direction, false AS parallel, 'type_observations' AS evidence_table, 'parameter,function,call_site,argument,syntax_node' AS src_kinds, 'type' AS dst_kinds UNION ALL SELECT CAST(27 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the child term is part of the parent term, at its role and ordinal' AS direction, true AS parallel, 'type_term_args' AS evidence_table, 'type' AS src_kinds, 'type' AS dst_kinds UNION ALL SELECT CAST(28 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the term is an instance, object or `TypedDict` of the class' AS direction, false AS parallel, 'type_terms' AS evidence_table, 'type' AS src_kinds, 'class,external_symbol' AS dst_kinds UNION ALL SELECT CAST(29 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the class declares the record field, at its ordinal in the record''s field order' AS direction, false AS parallel, 'record_fields' AS evidence_table, 'class' AS src_kinds, 'field' AS dst_kinds UNION ALL SELECT CAST(30 AS SMALLINT) AS edge_kind, CAST(1 AS SMALLINT) AS derivation, 'the record field has the type' AS direction, false AS parallel, 'record_fields' AS evidence_table, 'field' AS src_kinds, 'type' AS dst_kinds UNION ALL SELECT CAST(31 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the document holds the passage, at its ordinal' AS direction, false AS parallel, 'passages' AS evidence_table, 'document' AS src_kinds, 'passage' AS dst_kinds UNION ALL SELECT CAST(32 AS SMALLINT) AS edge_kind, CAST(0 AS SMALLINT) AS derivation, 'the passage holds the code block, at its ordinal in the document' AS direction, false AS parallel, 'code_blocks' AS evidence_table, 'passage' AS src_kinds, 'code_block' AS dst_kinds UNION ALL SELECT CAST(33 AS SMALLINT) AS edge_kind, CAST(3 AS SMALLINT) AS derivation, 'the passage names the API element at the byte offset (`exact` or `lexical` on the evidence row; a lexical mention is `candidate`)' AS direction, true AS parallel, 'mentions' AS evidence_table, 'passage' AS src_kinds, 'export,class,function' AS dst_kinds
