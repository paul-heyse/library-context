---
source: crates/cpg-schema/tests/contracts.rs
expression: text
---
table statement_completions
family findings
key snapshot_id, source_fact_id
check unknown_reason: (kind = 5 AND reason IS NOT NULL) OR (kind <> 5 AND reason IS NULL)
check terminal_shape: (kind IN (1, 2, 3, 4) AND terminal_fact_id IS NOT NULL) OR (kind IN (0, 5) AND terminal_fact_id IS NULL)
check positive_work: work > 0
@lctx.family=findings
@lctx.table=statement_completions
snapshot_id: FixedSizeBinary(16) NOT NULL
source_fact_id: FixedSizeBinary(16) NOT NULL
statement_node_id: FixedSizeBinary(16) NOT NULL
function_node_id: FixedSizeBinary(16) NOT NULL
kind: Int16 NOT NULL [lctx.codebook=completion_kind]
terminal_fact_id: FixedSizeBinary(16) NULL
reason: Int16 NULL [lctx.codebook=boundary_reason]
work: Int64 NOT NULL
