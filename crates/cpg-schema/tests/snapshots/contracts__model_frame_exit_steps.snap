---
table model_frame_exit_steps
family findings
key snapshot_id, frame_exit_id, ordinal
check ordinal_nonnegative: ordinal >= 0
@lctx.family=findings
@lctx.table=model_frame_exit_steps
snapshot_id: FixedSizeBinary(16) NOT NULL
frame_exit_id: FixedSizeBinary(16) NOT NULL
ordinal: Int64 NOT NULL
operand_fact_id: FixedSizeBinary(16) NOT NULL
evidence_id: FixedSizeBinary(16) NOT NULL
status: Int16 NOT NULL [lctx.codebook=modeled_argument_evaluation_status]
kind: Int16 NOT NULL [lctx.codebook=summary_flow_step_kind]
