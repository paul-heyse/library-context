---
source: crates/cpg-schema/tests/contracts.rs
expression: text
---
table call_executions
family findings
key snapshot_id, execution_id
check counts_nonnegative: argument_count >= 0 AND prefix_count >= 0 AND invocation_count >= 0 AND work > 0
@lctx.family=findings
@lctx.table=call_executions
snapshot_id: FixedSizeBinary(16) NOT NULL
execution_id: FixedSizeBinary(16) NOT NULL
function_node_id: FixedSizeBinary(16) NOT NULL
call_node_id: FixedSizeBinary(16) NOT NULL
call_fact_id: FixedSizeBinary(16) NOT NULL
syntax_fact_id: FixedSizeBinary(16) NOT NULL
target_node_id: FixedSizeBinary(16) NOT NULL
pysa_fact_id: FixedSizeBinary(16) NOT NULL
model_id: FixedSizeBinary(16) NOT NULL
condition_id: FixedSizeBinary(16) NOT NULL
phase: Int16 NOT NULL [lctx.codebook=invocation_phase]
argument_count: Int64 NOT NULL
default_formal_count: Int64 NULL
default_formals_digest: FixedSizeBinary(32) NULL
prefix_count: Int64 NOT NULL
invocation_count: Int64 NOT NULL
prefix_digest: FixedSizeBinary(32) NOT NULL
invocation_digest: FixedSizeBinary(32) NOT NULL
reason: Int16 NULL [lctx.codebook=boundary_reason]
work: Int64 NOT NULL
