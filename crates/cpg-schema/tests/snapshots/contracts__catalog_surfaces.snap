table catalog_surfaces
family findings
key snapshot_id, declaration_node_id, ordinal
check ordinal: ordinal >= 0
@lctx.family=findings
@lctx.table=catalog_surfaces
snapshot_id: FixedSizeBinary(16) NOT NULL
declaration_node_id: FixedSizeBinary(16) NOT NULL
ordinal: Int64 NOT NULL
source_fact_id: FixedSizeBinary(16) NOT NULL
expression: Utf8 NOT NULL
related_node_id: FixedSizeBinary(16) NULL
resolved_target: Utf8 NULL
binding_mode: Utf8 NULL
accessor_role: Utf8 NULL
protocol: Utf8 NULL
registration: Utf8 NULL
admission: Utf8 NOT NULL
reason: Utf8 NULL
