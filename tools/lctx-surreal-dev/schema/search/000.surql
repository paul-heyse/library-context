DEFINE ANALYZER lctx_discovery TOKENIZERS CLASS,CAMEL FILTERS LOWERCASE;
DEFINE TABLE search_api_options TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON search_api_options TYPE string PERMISSIONS FULL;
DEFINE FIELD text ON search_api_options TYPE string PERMISSIONS FULL;
DEFINE FIELD digest ON search_api_options TYPE array<int, 32> PERMISSIONS FULL;
DEFINE FIELD scope_digest ON search_api_options TYPE string VALUE <string> digest PERMISSIONS FULL;
DEFINE INDEX exact_text ON search_api_options FIELDS derivation, scope_digest UNIQUE;
DEFINE INDEX lexical ON search_api_options FIELDS text FULLTEXT ANALYZER lctx_discovery BM25(1.5,0.75);
DEFINE TABLE search_documentation_deployment TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON search_documentation_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD text ON search_documentation_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD digest ON search_documentation_deployment TYPE array<int, 32> PERMISSIONS FULL;
DEFINE FIELD scope_digest ON search_documentation_deployment TYPE string VALUE <string> digest PERMISSIONS FULL;
DEFINE INDEX exact_text ON search_documentation_deployment FIELDS derivation, scope_digest UNIQUE;
DEFINE INDEX lexical ON search_documentation_deployment FIELDS text FULLTEXT ANALYZER lctx_discovery BM25(1.5,0.75);
DEFINE TABLE search_scenario TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON search_scenario TYPE string PERMISSIONS FULL;
DEFINE FIELD text ON search_scenario TYPE string PERMISSIONS FULL;
DEFINE FIELD digest ON search_scenario TYPE array<int, 32> PERMISSIONS FULL;
DEFINE FIELD scope_digest ON search_scenario TYPE string VALUE <string> digest PERMISSIONS FULL;
DEFINE INDEX exact_text ON search_scenario FIELDS derivation, scope_digest UNIQUE;
DEFINE INDEX lexical ON search_scenario FIELDS text FULLTEXT ANALYZER lctx_discovery BM25(1.5,0.75);
DEFINE TABLE search_source TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON search_source TYPE string PERMISSIONS FULL;
DEFINE FIELD text ON search_source TYPE string PERMISSIONS FULL;
DEFINE FIELD digest ON search_source TYPE array<int, 32> PERMISSIONS FULL;
DEFINE FIELD scope_digest ON search_source TYPE string VALUE <string> digest PERMISSIONS FULL;
DEFINE INDEX exact_text ON search_source FIELDS derivation, scope_digest UNIQUE;
DEFINE INDEX lexical ON search_source FIELDS text FULLTEXT ANALYZER lctx_discovery BM25(1.5,0.75);
DEFINE TABLE vector TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD encoder_hash ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD policy_key ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD library_input ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON vector TYPE int PERMISSIONS FULL;
DEFINE FIELD full_key ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD projection_key ON vector TYPE string PERMISSIONS FULL;
DEFINE FIELD dependencies ON vector TYPE array<record<entity | assertion | compiler_record>> PERMISSIONS FULL;
DEFINE FIELD embedding ON vector TYPE array<float, 1024> PERMISSIONS FULL;
DEFINE INDEX cohort ON vector FIELDS derivation, projection_key, library_input, family;
DEFINE INDEX encoder_scope ON vector FIELDS encoder_hash;
DEFINE INDEX policy_scope ON vector FIELDS policy_key;
DEFINE INDEX library_scope ON vector FIELDS library_input;
DEFINE INDEX family_scope ON vector FIELDS family;
DEFINE INDEX neighbor ON vector FIELDS embedding HNSW DIMENSION 1024 DIST COSINE TYPE F32 EFC 150 M 12 M0 24 LM 0.40242960438184466f;
DEFINE TABLE lex_occurs TYPE RELATION IN search_api_options | search_documentation_deployment | search_scenario | search_source OUT entity_anchor ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON lex_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON lex_occurs TYPE int PERMISSIONS FULL;
DEFINE FIELD unit ON lex_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD unit_node ON lex_occurs TYPE record<entity_anchor> PERMISSIONS FULL;
DEFINE FIELD unit_payload ON lex_occurs TYPE record<entity> PERMISSIONS FULL;
DEFINE FIELD dependencies ON lex_occurs TYPE array<record<entity | assertion | compiler_record>> PERMISSIONS FULL;
DEFINE INDEX exact_unit_payload ON lex_occurs FIELDS derivation, unit_payload;
DEFINE FIELD window ON lex_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD part ON lex_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD binding ON lex_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD exact_name ON lex_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD exact_path ON lex_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD exact_option ON lex_occurs TYPE string PERMISSIONS FULL;
DEFINE INDEX exact_name ON lex_occurs FIELDS exact_name;
DEFINE INDEX exact_path ON lex_occurs FIELDS exact_path;
DEFINE INDEX exact_option ON lex_occurs FIELDS exact_option;
DEFINE FIELD context ON lex_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD input ON lex_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD member ON lex_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD anchor ON lex_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD eligible ON lex_occurs TYPE bool PERMISSIONS FULL;
DEFINE FIELD occurrence_key ON lex_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD scope_input ON lex_occurs TYPE string VALUE <string> input PERMISSIONS FULL;
DEFINE FIELD scope_member ON lex_occurs TYPE string VALUE <string> member PERMISSIONS FULL;
DEFINE FIELD scope_context ON lex_occurs TYPE string VALUE <string> context PERMISSIONS FULL;
DEFINE INDEX occurrence ON lex_occurs FIELDS derivation, occurrence_key UNIQUE;
DEFINE INDEX eligible_input ON lex_occurs FIELDS derivation, eligible, scope_input, family, scope_member, scope_context;
DEFINE INDEX document_occurrences ON lex_occurs FIELDS in, eligible, scope_input, scope_member, scope_context, occurrence_key;
DEFINE INDEX target_occurrences ON lex_occurs FIELDS out, family, occurrence_key;
DEFINE FIELD scope_window ON lex_occurs TYPE string VALUE <string> window PERMISSIONS FULL;
DEFINE INDEX window_occurrences ON lex_occurs FIELDS derivation, scope_window, eligible;
DEFINE TABLE vec_occurs TYPE RELATION IN vector OUT entity_anchor ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON vec_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON vec_occurs TYPE int PERMISSIONS FULL;
DEFINE FIELD unit ON vec_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD unit_node ON vec_occurs TYPE record<entity_anchor> PERMISSIONS FULL;
DEFINE FIELD unit_payload ON vec_occurs TYPE record<entity> PERMISSIONS FULL;
DEFINE FIELD dependencies ON vec_occurs TYPE array<record<entity | assertion | compiler_record>> PERMISSIONS FULL;
DEFINE INDEX exact_unit_payload ON vec_occurs FIELDS derivation, unit_payload;
DEFINE FIELD window ON vec_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD part ON vec_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD binding ON vec_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD exact_name ON vec_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD exact_path ON vec_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD exact_option ON vec_occurs TYPE string PERMISSIONS FULL;
DEFINE INDEX exact_name ON vec_occurs FIELDS exact_name;
DEFINE INDEX exact_path ON vec_occurs FIELDS exact_path;
DEFINE INDEX exact_option ON vec_occurs FIELDS exact_option;
DEFINE FIELD context ON vec_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD input ON vec_occurs TYPE array<int, 16> PERMISSIONS FULL;
DEFINE FIELD member ON vec_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD anchor ON vec_occurs TYPE none | array<int, 16> | null PERMISSIONS FULL;
DEFINE FIELD eligible ON vec_occurs TYPE bool PERMISSIONS FULL;
DEFINE FIELD occurrence_key ON vec_occurs TYPE string PERMISSIONS FULL;
DEFINE FIELD scope_input ON vec_occurs TYPE string VALUE <string> input PERMISSIONS FULL;
DEFINE FIELD scope_member ON vec_occurs TYPE string VALUE <string> member PERMISSIONS FULL;
DEFINE FIELD scope_context ON vec_occurs TYPE string VALUE <string> context PERMISSIONS FULL;
DEFINE INDEX occurrence ON vec_occurs FIELDS derivation, in, occurrence_key UNIQUE;
DEFINE INDEX eligible_input ON vec_occurs FIELDS derivation, eligible, scope_input, family, scope_member, scope_context;
DEFINE INDEX document_occurrences ON vec_occurs FIELDS in, eligible, scope_input, scope_member, scope_context, occurrence_key;
DEFINE INDEX target_occurrences ON vec_occurs FIELDS out, family, occurrence_key;
DEFINE FIELD scope_window ON vec_occurs TYPE string VALUE <string> window PERMISSIONS FULL;
DEFINE INDEX window_occurrences ON vec_occurs FIELDS derivation, scope_window, eligible;
DEFINE TABLE lexical_document TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON lexical_document TYPE string PERMISSIONS FULL;
DEFINE FIELD length ON lexical_document TYPE int PERMISSIONS FULL;
DEFINE FIELD terms ON lexical_document TYPE array<object> PERMISSIONS FULL;
DEFINE FIELD terms.*.term ON lexical_document TYPE string PERMISSIONS FULL;
DEFINE FIELD terms.*.tf ON lexical_document TYPE int PERMISSIONS FULL;
DEFINE FIELD terms.*.dl ON lexical_document TYPE int PERMISSIONS FULL;
DEFINE TABLE lexical_member TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON lexical_member TYPE string PERMISSIONS FULL;
DEFINE FIELD scope ON lexical_member TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON lexical_member TYPE int PERMISSIONS FULL;
DEFINE FIELD source ON lexical_member TYPE record<search_api_options | search_documentation_deployment | search_scenario | search_source> PERMISSIONS FULL;
DEFINE FIELD in ON lexical_member TYPE record<lexical_document> PERMISSIONS FULL;
DEFINE FIELD out ON lexical_member TYPE record<lexical_corpus> PERMISSIONS FULL;
DEFINE TABLE lexical_term TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON lexical_term TYPE string PERMISSIONS FULL;
DEFINE FIELD scope ON lexical_term TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON lexical_term TYPE int PERMISSIONS FULL;
DEFINE FIELD term ON lexical_term TYPE string PERMISSIONS FULL;
DEFINE FIELD df ON lexical_term TYPE int PERMISSIONS FULL;
DEFINE TABLE lexical_corpus TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD derivation ON lexical_corpus TYPE string PERMISSIONS FULL;
DEFINE FIELD scope ON lexical_corpus TYPE string PERMISSIONS FULL;
DEFINE FIELD family ON lexical_corpus TYPE int PERMISSIONS FULL;
DEFINE FIELD documents ON lexical_corpus TYPE int PERMISSIONS FULL;
DEFINE FIELD total_length ON lexical_corpus TYPE int PERMISSIONS FULL;
DEFINE INDEX scoped_document ON lexical_member FIELDS scope, family, source UNIQUE;
DEFINE INDEX scoped_term ON lexical_term FIELDS scope, family, term UNIQUE;
DEFINE INDEX scoped_corpus ON lexical_corpus FIELDS scope, family UNIQUE;
