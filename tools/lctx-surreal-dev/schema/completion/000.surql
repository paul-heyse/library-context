DEFINE FIELD validity_epoch ON native_installation TYPE int DEFAULT 1; DEFINE FIELD completed_revision ON native_attempt TYPE option<int>; DEFINE FIELD completed_bindings ON native_attempt TYPE option<string>; DEFINE FIELD completed_identity ON native_attempt TYPE option<string>; DEFINE FIELD completed_state ON native_attempt TYPE option<string>; DEFINE FIELD validity_epoch ON native_attempt TYPE option<int>;
DEFINE TABLE native_completed_admission SCHEMAFULL; DEFINE FIELD descriptor ON native_completed_admission TYPE bytes; DEFINE FIELD completed_admission ON native_attempt TYPE option<record<native_completed_admission>>; DEFINE TABLE native_completed_state SCHEMAFULL; DEFINE FIELD descriptor ON native_completed_state TYPE bytes; DEFINE FIELD completed ON native_completed_state TYPE bool; DEFINE TABLE native_completed_view SCHEMAFULL; DEFINE FIELD id ON native_completed_view TYPE string; DEFINE FIELD completion ON native_completed_view TYPE record<native_completed_state>; DEFINE FIELD logical_view ON native_completed_view TYPE string; DEFINE FIELD realization ON native_completed_view TYPE string; DEFINE FIELD incarnation ON native_completed_view TYPE int; DEFINE FIELD installation_completion ON native_completed_view TYPE string; DEFINE INDEX completion_view ON native_completed_view FIELDS completion,logical_view,id UNIQUE;
DEFINE TABLE compiler_view_realization SCHEMAFULL; DEFINE FIELD descriptor ON compiler_view_realization TYPE bytes; DEFINE FIELD sealed ON compiler_view_realization TYPE bool; DEFINE TABLE compiler_view_completion SCHEMAFULL; DEFINE FIELD descriptor ON compiler_view_completion TYPE bytes; DEFINE FIELD completed ON compiler_view_completion TYPE bool; DEFINE TABLE compiler_view_member SCHEMAFULL; DEFINE FIELD realization ON compiler_view_member TYPE record<compiler_view_realization>; DEFINE FIELD relation ON compiler_view_member TYPE string; DEFINE FIELD semantic_key ON compiler_view_member TYPE string; DEFINE FIELD node ON compiler_view_member TYPE record<entity | assertion | compiler_record>; DEFINE FIELD content ON compiler_view_member TYPE string; DEFINE INDEX realization_key ON compiler_view_member FIELDS realization,relation,semantic_key UNIQUE; DEFINE INDEX realization_nodes ON compiler_view_member FIELDS realization,node;
DEFINE TABLE native_publication_staging SCHEMAFULL; DEFINE FIELD id ON native_publication_staging TYPE string; DEFINE FIELD attempt ON native_publication_staging TYPE record<native_attempt>; DEFINE FIELD completion ON native_publication_staging TYPE record<native_completed_state>; DEFINE FIELD admission ON native_publication_staging TYPE record<native_completed_admission>; DEFINE FIELD derivation ON native_publication_staging TYPE string; DEFINE FIELD state ON native_publication_staging TYPE string; DEFINE FIELD derived_children ON native_publication_staging TYPE option<int>; DEFINE FIELD derived_inventory ON native_publication_staging TYPE option<string>; DEFINE FIELD generation ON native_publication_staging TYPE string; DEFINE FIELD epoch ON native_publication_staging TYPE int; DEFINE FIELD validity_epoch ON native_publication_staging TYPE int; DEFINE INDEX attempt_staging ON native_publication_staging FIELDS attempt,id;
DEFINE TABLE native_pending_original TYPE NORMAL SCHEMAFULL; DEFINE FIELD id ON native_pending_original TYPE string; DEFINE FIELD attempt ON native_pending_original TYPE record<native_attempt>; DEFINE FIELD logical_source ON native_pending_original TYPE record<original>; DEFINE INDEX pending_attempt ON native_pending_original FIELDS attempt,id; DEFINE TABLE native_pending_original_ordinal TYPE NORMAL SCHEMAFULL; DEFINE FIELD id ON native_pending_original_ordinal TYPE string; DEFINE FIELD root ON native_pending_original_ordinal TYPE record<native_pending_original>; DEFINE FIELD ordinal ON native_pending_original_ordinal TYPE int; DEFINE FIELD byte_len ON native_pending_original_ordinal TYPE int; DEFINE FIELD content ON native_pending_original_ordinal TYPE string; DEFINE INDEX pending_ordinals ON native_pending_original_ordinal FIELDS root,id; DEFINE TABLE native_pending_original_piece TYPE NORMAL SCHEMAFULL; DEFINE FIELD ordinal ON native_pending_original_piece TYPE record<native_pending_original_ordinal>; DEFINE FIELD start ON native_pending_original_piece TYPE int; DEFINE FIELD bytes ON native_pending_original_piece TYPE bytes; DEFINE FIELD content ON native_pending_original_piece TYPE string; DEFINE INDEX pending_pieces ON native_pending_original_piece FIELDS ordinal,start UNIQUE; DEFINE INDEX pending_original_retirement ON native_retirement_item FIELDS object,incarnation;
DEFINE TABLE compiler_binding_descriptor SCHEMAFULL; DEFINE FIELD id ON compiler_binding_descriptor TYPE string; DEFINE FIELD descriptor ON compiler_binding_descriptor TYPE bytes; DEFINE FIELD view ON compiler_binding_descriptor TYPE record<compiler_view>; DEFINE FIELD source_identity ON compiler_binding_descriptor TYPE string; DEFINE INDEX descriptor_view ON compiler_binding_descriptor FIELDS view,id;
DEFINE TABLE native_validation_premise SCHEMAFULL; DEFINE FIELD descriptor ON native_validation_premise TYPE bytes;